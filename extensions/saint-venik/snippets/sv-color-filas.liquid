{%- comment -%} Dos filas de color: metal arriba, cordón/gema abajo. docs/bloques.md: «sv-color-filas.liquid» {%- endcomment -%}
{%- liquid
 assign ta = producto.tags | join: '|' | downcase | prepend: '|' | append: '|'
 assign se = ''
 assign sf = ''
 assign sfe = ''
 for e in colores
  assign f = e.fila.value | strip
  assign t = e.etiqueta.value | downcase | strip
  assign ag = t | prepend: '|' | append: '|'
  if f != blank and t != blank and ta contains ag
   assign se = t
   assign sf = f
   assign sfe = e.fila_en.value | strip
   break
  endif
 endfor
 assign me = '|'
 assign sg = '|'
 for vuelta in (1..2)
  for p in orden
   assign q = p | downcase | strip
   for e in colores
    assign t = e.etiqueta.value | downcase | strip
    if t != blank
     if vuelta == 2 or t == q
      assign f = e.fila.value | strip
      assign ag = t | prepend: '|' | append: '|'
      if f == blank
       unless me contains ag
        assign me = me | append: t | append: '|'
       endunless
      elsif f == sf
       unless sg contains ag
        assign sg = sg | append: t | append: '|'
       endunless
      endif
     endif
    endif
   endfor
   if vuelta == 2
    break
   endif
  endfor
 endfor
 assign lm = me | split: '|'
 assign ls = sg | split: '|'
 assign ma = ''
 for m in lm
  assign ag = m | prepend: '|' | append: '|'
  if m != blank and ta contains ag
   assign ma = m
   break
  endif
 endfor
 assign cl = '|'
 for h in hermanos
  assign th = h.tags | join: '|' | downcase | prepend: '|' | append: '|'
  assign mh = ''
  assign sh = ''
  for m in lm
   assign ag = m | prepend: '|' | append: '|'
   if m != blank and th contains ag
    assign mh = m
    break
   endif
  endfor
  for s in ls
   assign ag = s | prepend: '|' | append: '|'
   if s != blank and th contains ag
    assign sh = s
    break
   endif
  endfor
  assign cl = cl | append: h.id | append: ':' | append: mh | append: ':' | append: sh | append: '|'
 endfor
 assign t2 = sf
 if idioma == 'en' and sfe != blank
  assign t2 = sfe
 endif
-%}
{%- for fila in (1..2) -%}
{%- capture lista -%}
{%- if fila == 1 -%}{%- assign items = lm -%}{%- else -%}{%- assign items = ls -%}{%- endif -%}
{%- for x in items -%}{%- if x != blank -%}
{%- liquid
 assign prod = nil
 assign act = false
 if fila == 1
  assign actual = ma
 else
  assign actual = se
 endif
 if x == actual
  assign prod = producto
  assign act = true
 else
  for h in hermanos
   if fila == 1
    assign k = h.id | prepend: '|' | append: ':' | append: x | append: ':' | append: se | append: '|'
   else
    assign k = h.id | prepend: '|' | append: ':' | append: ma | append: ':' | append: x | append: '|'
   endif
   if cl contains k
    assign prod = h
    break
   endif
  endfor
  if prod == nil
   for h in hermanos
    for m in lm
     if fila == 1
      assign k = h.id | prepend: '|' | append: ':' | append: x | append: ':'
     else
      assign k = h.id | prepend: '|' | append: ':' | append: m | append: ':' | append: x | append: '|'
     endif
     if cl contains k
      assign prod = h
      break
     endif
    endfor
    if prod != nil
     break
    endif
   endfor
  endif
 endif
-%}
{%- if prod != nil -%}{%- for e in colores -%}
{%- assign t = e.etiqueta.value | downcase | strip -%}{%- assign f = e.fila.value | strip -%}
{%- if t == x -%}{%- if fila == 1 and f != blank -%}{%- continue -%}{%- endif -%}
{%- assign nom = e.nombre.value -%}{%- if idioma == 'en' and e.nombre_en.value != blank -%}{%- assign nom = e.nombre_en.value -%}{%- endif -%}
{%- if act -%}{%- assign nom_act = nom -%}{%- endif -%}
{%- render 'sv-color-swatch', producto: prod, nombre: nom, color: e.muestra.value, imagen: e.imagen_muestra.value, actual: act, mostrar_etiqueta: mostrar_etiqueta, marcar_agotado: marcar_agotado -%}
{%- break -%}{%- endif -%}
{%- endfor -%}{%- endif -%}
{%- endif -%}{%- endfor -%}
{%- endcapture -%}
{%- if fila == 1 -%}{%- assign titulo = encabezado -%}{%- else -%}{%- assign titulo = t2 -%}{%- endif -%}
<div class="sv-colors__fila">
{%- if fila == 2 or mostrar_encabezado and encabezado != blank -%}
<div class="sv-colors__heading"><span class="sv-colors__label">{{ titulo }}</span>
{%- if mostrar_nombre_actual and nom_act != blank -%}<span class="sv-colors__sep" aria-hidden="true">-</span><span class="sv-colors__current">{{ nom_act }}</span>{%- endif -%}</div>
{%- endif -%}
<div class="sv-colors__list" role="group" aria-label="{{ titulo | escape }}">{{ lista }}</div></div>
{%- assign nom_act = '' -%}
{%- endfor -%}
