{%- comment -%} nota 1: docs/bloques.md {%- endcomment -%}
{%- liquid
  assign e_modo = cfg.desc_activo.value | default: 'no' | append: ''
  assign e_pre = 'html'
  if e_modo == 'prueba'
    assign e_pre = 'html.sv-desc-p'
  endif
  assign e_precio = cfg.desc_precio_letra.value | default: 17
  assign e_letra = cfg.desc_letra.value | default: 14
-%}
{%- if e_modo == 'si' or e_modo == 'prueba' -%}
  {%- unless cfg.desc_precio.value == 'no' -%}
    <style>
      {{ e_pre }} .sv-desc-precio { font-size: {{ e_letra }}px; }
      {%- if e_precio > 0 %}
      {{ e_pre }} .product-block--price .product__price { font-size: {{ e_precio }}px; }
      {%- endif %}
      {%- if e_modo == 'si' %}
      .product__price-savings[data-save-price] { display: none !important; }
      {%- endif %}
    </style>
  {%- endunless -%}
{%- endif -%}
{%- for e in shop.metaobjects.sv_configuracion_2.values -%}
  {%- if e.precio_colores.value == 'si' -%}
    {%- assign o = e.precio_oferta.value | default: '#E32C2B' -%}{%- assign x = e.precio_tachado.value | default: '#8C8C8C' -%}
    <style>.grid-product__price--original,.product__price--compare{color:{{ x }}}.grid-product__price--original2,.product__price.on-sale{color:{{ o }}}</style>
  {%- endif -%}{%- break -%}
{%- endfor -%}
