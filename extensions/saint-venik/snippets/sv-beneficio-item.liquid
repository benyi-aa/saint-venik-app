{%- comment -%} docs/bloques.md: «sv-beneficio-item.liquid · 1» {%- endcomment -%}

{%- liquid
  assign texto = b.nombre.value
  if lang == 'en' and b.nombre_en.value != blank
    assign texto = b.nombre_en.value
  endif
-%}

{%- if texto != blank -%}
  <li class="sv-benef__item">
    {%- render 'sv-beneficio-icono', b: b -%}
    <span class="sv-benef__texto">{{ texto }}</span>
  </li>
{%- endif -%}
