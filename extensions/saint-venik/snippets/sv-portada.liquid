{%- comment -%} Portada de las colecciones (foto con el titulo encima en el telefono): ver README. Recibe `cfg`. {%- endcomment -%}
{%- comment -%} El estado vive en sv_configuracion_2: la primera definicion ya tiene los 40 campos que admite Shopify. {%- endcomment -%}
{%- assign p = cfg.colecciones_portada.value -%}
{%- for e in shop.metaobjects.sv_configuracion_2.values -%}{%- assign p = e.colecciones_portada.value | default: p -%}{%- break -%}{%- endfor -%}
{%- assign p = p | default: 'si' | append: '' -%}
{%- if template.name == 'collection' and p != 'no' -%}
  {{- 'sv-portada.css' | asset_url | stylesheet_tag -}}
  <script>try{ {%- if p == 'prueba' -%}/[?&]sv-vista(=1)?(&|$)/.test(location.search)&&sessionStorage.setItem('sv-vista','1');sessionStorage.getItem('sv-vista')==='1'&& {%- endif -%}document.documentElement.classList.add('sv-portada')}catch(e){}</script>
  <script src="{{ 'sv-portada.js' | asset_url }}" defer></script>
{%- endif -%}
{%- comment -%} Navidad (9-nov): banners de terciopelo rojo, sv-navidad-portada-<foto>.jpg en Archivos, uno por cada foto de verano (coleccion_<foto>.jpg). Con la temporada en Navidad, o con ?sv-navidad=1 para verlo antes (=0 lo quita). Ver docs/tema.md. {%- endcomment -%}
{%- if template.name == 'collection' -%}
{%- liquid
  assign tm = 'normal'
  for e in shop.metaobjects.sv_configuracion_2.values
    assign tm = e.temporada.value | default: 'normal' | append: ''
    break
  endfor
  assign ks = 'cadena,pulsera,anillos,colgantes,conjuntos,essentials' | split: ','
  assign hay = ''
-%}
{%- capture mapa -%}{%- for k in ks -%}{%- assign n = 'sv-navidad-portada-' | append: k | append: '.jpg' -%}{%- assign f = images[n] -%}{%- if f != blank -%}{%- assign hay = hay | append: k | append: ',' -%}"{{ k }}":"{{ f | image_url: width: 2400 }}",{%- endif -%}{%- endfor -%}{%- endcapture -%}
{%- if hay != '' -%}
<style>{%- assign hs = hay | split: ',' -%}{%- for k in hs -%}html.sv-nav img[src*="/coleccion_{{ k }}."]{%- unless forloop.last -%},{%- endunless -%}{%- endfor -%},html.sv-nav img[data-svn]:not(.sv-ok){visibility:hidden}html.sv-portada img[src*="sv-navidad-portada"]{--sv-alto:100%;--sv-encuadre:50% 50%;--sv-y:50%}html.sv-portada img[src*="sv-navidad-portada-pulsera"]{--sv-y:58%}html.sv-portada img[src*="sv-navidad-portada-anillos"]{--sv-y:48%}html.sv-portada img[src*="sv-navidad-portada-essentials"]{--sv-y:55%}html.sv-portada img[src*="sv-navidad-portada-colgantes"]{--sv-y:72%}html.sv-portada img[src*="sv-navidad-portada-conjuntos"]{--sv-y:82%}</style>
<script>try{(function(){var s=sessionStorage,m=location.search.match(/[?&]sv-navidad=([01])/);if(m)m[1]==='1'?s.setItem('sv-navidad','1'):s.removeItem('sv-navidad');var on={% if tm == 'navidad' %}1{% else %}s.getItem('sv-navidad')==='1'{% endif %};if(!on)return;var M={ {{- mapa -}}"":""};document.documentElement.classList.add('sv-nav');function c(){[].forEach.call(document.querySelectorAll('img[src*="/coleccion_"]'),function(i){var k=(i.getAttribute('src').match(/\/coleccion_([a-z]+)\./)||[])[1];if(k&&M[k]){i.setAttribute('data-svn','');i.addEventListener('load',function(){i.classList.add('sv-ok')},{once:true});i.sizes='100vw';i.srcset=[800,1400,2400].map(function(w){return M[k].replace('width=2400','width='+w)+' '+w+'w'}).join(',');i.src=M[k]}})}document.readyState==='loading'?document.addEventListener('DOMContentLoaded',c):c()})()}catch(e){document.documentElement.classList.remove('sv-nav')}</script>
{%- endif -%}
{%- endif -%}
