{%- comment -%} Portada de las colecciones (foto con el titulo encima en el telefono): ver README. Recibe `cfg`. {%- endcomment -%}
{%- assign p = cfg.colecciones_portada.value -%}
{%- for e in shop.metaobjects.sv_configuracion_2.values -%}{%- assign p = e.colecciones_portada.value | default: p -%}{%- break -%}{%- endfor -%}
{%- assign p = p | default: 'si' | append: '' -%}
{%- if template.name == 'collection' and p != 'no' -%}
  {{- 'sv-portada.css' | asset_url | stylesheet_tag -}}
  <script>try{ {%- if p == 'prueba' -%}/[?&]sv-vista(=1)?(&|$)/.test(location.search)&&sessionStorage.setItem('sv-vista','1');sessionStorage.getItem('sv-vista')==='1'&& {%- endif -%}document.documentElement.classList.add('sv-portada')}catch(e){}</script>
  <script src="{{ 'sv-portada.js' | asset_url }}" defer></script>
{%- endif -%}
{%- if template.name == 'collection' -%}
{%- liquid
  assign tm = 'normal'
  for e in shop.metaobjects.sv_configuracion_2.values
    assign tm = e.temporada.value | default: 'normal' | append: ''
    break
  endfor
  if tt != blank and tt != 'panel'
    assign tm = tt
  endif
  assign kt = tm
  if tm == 'normal'
    assign kt = 'navidad'
  endif
  assign pf = 'sv-' | append: kt | append: '-portada-'
  assign ks = 'cadena,pulsera,anillos,colgantes,conjuntos,essentials' | split: ','
  assign hay = ''
-%}
{%- liquid
  assign hm = ''
  assign bs = false
  if collection.handle == 'best-sellers'
    assign bs = true
  endif
-%}
{%- capture mapa -%}{%- for k in ks -%}{%- assign n = pf | append: k | append: '.jpg' -%}{%- assign nb = pf | append: 'bestsellers.jpg' -%}{%- if k == 'cadena' and bs and images[nb] != blank -%}{%- assign n = nb -%}{%- endif -%}{%- assign f = images[n] -%}{%- if f != blank -%}{%- assign hay = hay | append: k | append: ',' -%}"{{ k }}":"{{ f | image_url: width: 2400 }}",{%- endif -%}{%- endfor -%}{%- endcapture -%}
{%- capture nmov -%}{%- for k in ks -%}{%- assign n = pf | append: k | append: '-movil.jpg' -%}{%- if k == 'cadena' and bs -%}{%- assign n = pf | append: 'bestsellers-movil.jpg' -%}{%- endif -%}{%- assign f = images[n] -%}{%- if f != blank -%}"{{ k }}":"{{ f | image_url: width: 2400 }}",{%- endif -%}{%- endfor -%}{%- endcapture -%}
{%- assign hd = '' -%}{%- assign fb = images['sv-portada-bestsellers.jpg'] -%}{%- assign fbm = images['sv-portada-bestsellers-movil.jpg'] | default: fb -%}
{%- capture vesc -%}{%- if bs and fb != blank -%}{%- assign hd = 'cadena,' -%}"cadena":"{{ fb | image_url: width: 2400 }}",{%- endif -%}{%- endcapture -%}
{%- capture vmov -%}{%- if bs -%}{%- if fbm != blank -%}{%- assign hm = 'cadena,' -%}"cadena":"{{ fbm | image_url: width: 2400 }}",{%- endif -%}{%- else -%}{%- for k in ks -%}{%- assign n = 'sv-portada-movil-' | append: k | append: '.jpg' -%}{%- assign f = images[n] -%}{%- if f != blank -%}{%- assign hm = hm | append: k | append: ',' -%}"{{ k }}":"{{ f | image_url: width: 2400 }}",{%- endif -%}{%- endfor -%}{%- endif -%}{%- endcapture -%}
{%- if hay != '' or hm != '' or hd != '' -%}
<style>{%- if hd != '' -%}html.sv-pd img[src*="/coleccion_cadena."],html.sv-pd img[data-svn]:not(.sv-ok){visibility:hidden}{%- endif -%}{%- assign hs = hay | append: 'x' | split: ',' -%}{%- for k in hs -%}html.sv-nav img[src*="/coleccion_{{ k }}."],{%- endfor -%}html.sv-nav img[data-svn]:not(.sv-ok){visibility:hidden}@media (max-width:767px){ {%- assign hs = hm | append: 'x' | split: ',' -%}{%- for k in hs -%}html.sv-pm img[src*="/coleccion_{{ k }}."],{%- endfor -%}html.sv-pm img[data-svn]:not(.sv-ok){visibility:hidden}html.sv-portada img[src*="-movil."]{--sv-alto:100%;--sv-encuadre:50% 50%}}html.sv-portada img[src*="{{ pf }}"]{--sv-alto:100%;--sv-encuadre:50% 50%;--sv-y:50%}html.sv-portada img[src*="sv-navidad-portada-pulsera"]{--sv-y:53%}html.sv-portada img[src*="sv-navidad-portada-anillos"]{--sv-y:48%}html.sv-portada img[src*="sv-navidad-portada-essentials"]{--sv-y:54%}html.sv-portada img[src*="sv-navidad-portada-colgantes"]{--sv-y:54%}html.sv-portada img[src*="sv-navidad-portada-conjuntos"]{--sv-y:48%}html.sv-portada img[src*="sv-navidad-portada-bestsellers"]{--sv-y:56%}html.sv-portada img[src*="sv-navidad-portada-cadena"]{--sv-y:50%}</style>
<script>try{(function(){var d=document.documentElement,s=sessionStorage,m=location.search.match(/[?&]sv-navidad=([01])/);if(m)m[1]==='1'?s.setItem('sv-navidad','1'):s.removeItem('sv-navidad');var on={% if tm != 'normal' %}1{% else %}s.getItem('sv-navidad')==='1'{% endif %},q=matchMedia('(max-width:767px)'),N={ {{- mapa -}}"":""},NM={ {{- nmov -}}"":""},V={ {{- vmov -}}"":""},VD={ {{- vesc -}}"":""},M;function a(){var mov=q.matches;M=Object.assign({},mov?V:VD,on?N:0,on&&mov?NM:0);d.classList.toggle('sv-pm',mov);d.classList.toggle('sv-pd',!mov);on&&d.classList.add('sv-nav')}a();if(Object.keys(Object.assign({},V,VD,on?N:0,on?NM:0)).length<2)return;function c(){[].forEach.call(document.querySelectorAll('img[src*="/coleccion_"],img[data-svk]'),function(i){var k=i.getAttribute('data-svk')||(i.getAttribute('src').match(/\/coleccion_([a-z]+)\./)||[])[1];if(!k)return;if(!i.dataset.svk){i.dataset.svk=k;i.dataset.svo=i.getAttribute('src');i.dataset.svs=i.getAttribute('srcset')||''}var u=M[k];if(u){if(i.getAttribute('src')===u)return;i.setAttribute('data-svn','');i.addEventListener('load',function(){i.classList.add('sv-ok')},{once:true});i.sizes='100vw';i.srcset=[800,1400,2400].map(function(w){return u.replace('width=2400','width='+w)+' '+w+'w'}).join(',');i.src=u}else if(i.hasAttribute('data-svn')){i.removeAttribute('data-svn');i.srcset=i.dataset.svs;i.src=i.dataset.svo}})}document.readyState==='loading'?document.addEventListener('DOMContentLoaded',c):c();q.addEventListener('change',function(){a();c()})})()}catch(e){document.documentElement.classList.remove('sv-nav','sv-pm','sv-pd')}</script>
{%- endif -%}
{%- endif -%}
