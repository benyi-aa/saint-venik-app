{%- comment -%} Inicio: cuadricula de colecciones sobre negro y fotos de Navidad. Ver docs/tema.md, «Colecciones del inicio». {%- endcomment -%}
{%- if template.name == 'index' -%}
{%- liquid
  assign m = 'prueba'
  assign tm = 'normal'
  for e in shop.metaobjects.sv_configuracion_2.values
    assign m = e.categorias_inicio.value | default: 'prueba' | append: ''
    assign tm = e.temporada.value | default: 'normal' | append: ''
    break
  endfor
  assign p = 'html'
  if m == 'prueba'
    assign p = 'html.sv-ini'
  endif
  assign g = '[id$="__promo-grid2"]'
-%}
{%- if m == 'prueba' -%}<script>try{/[?&]sv-vista(=1)?(&|$)/.test(location.search)&&sessionStorage.setItem('sv-vista','1');sessionStorage.getItem('sv-vista')==='1'&&document.documentElement.classList.add('sv-ini')}catch(e){}</script>{%- endif -%}
<style>
{%- if m != 'no' -%}{{ p }} {{ g }}{background:#000}{{ p }} {{ g }} .promo-grid{padding-top:15px;padding-bottom:15px}@media (min-width:590px){ {{ p }} {{ g }} .promo-grid{padding-top:30px;padding-bottom:30px}}{{ p }} {{ g }}+.shopify-section{margin-top:0!important;margin-bottom:0!important}{%- endif -%}
{%- if tm == 'navidad' -%}{%- assign hs = 'cadenas,pulseras,colgantes,anillos,conjuntos,best-sellers' | split: ',' -%}{%- for h in hs -%}{%- assign f = collections[h].metafields.custom.foto_navidad.value -%}{%- if f -%}{{ g }} .promo-grid__container:has(a[href$="/collections/{{ h }}"]) .promo-grid__bg{background:#5c0a10 url({{ f | image_url: width: 1400 }}) center/cover}{{ g }} .promo-grid__container:has(a[href$="/collections/{{ h }}"]) .promo-grid__bg image-element{display:none}{%- endif -%}{%- endfor -%}{%- endif -%}
</style>
{%- comment -%} Banner «Tu cadena de cada dia» (reunion 9-nov): foto mas cerca de la cadena, texto sobre degradado, boton chico redondeado, sin espacios blancos y el texto entra suave. Ver docs/tema.md. {%- endcomment -%}
<style>.custom__item:has(.usp-section,.sv-usp){margin-bottom:0!important}.custom__item:has(.hero-banner,.sv-hero-daily){margin-bottom:0!important}.custom-content:has(.hero-banner,.sv-hero-daily){margin-bottom:0!important}.shopify-section:has(.hero-banner,.sv-hero-daily),.shopify-section:has(.hero-banner,.sv-hero-daily) .index-section{margin-bottom:0!important;padding-bottom:0!important}.hero-banner,.sv-hero-daily__frame{margin:0!important}.custom__item-inner:has(.hero-banner,.sv-hero-daily){display:block;vertical-align:top}.index-section:has(>.page-width:empty){margin:0!important}.hero-banner:has(img[src*="185102"]),.sv-hero-daily__frame:has(img[src*="185102"]){height:460px}.hero-banner:has(img[src*="185102"]) img,.sv-hero-daily__frame:has(img[src*="185102"]) img{height:100%;object-fit:cover;object-position:60% 50%}.hero-banner::after,.sv-hero-daily__frame::after{content:'';position:absolute;inset:0;pointer-events:none;background:linear-gradient(180deg,rgba(0,0,0,0) 42%,rgba(0,0,0,.78) 100%)}.hero-content,.sv-hero-daily__content{z-index:1;top:auto!important;bottom:22px;left:20px!important;right:20px;max-width:none!important;padding:0!important;transform:none!important;text-shadow:none!important}.hero-content h1,.sv-hero-daily__content h2{margin:0 0 6px!important}.hero-content p,.sv-hero-daily__content p{font-size:14px!important;line-height:1.45;margin:0 0 14px!important;opacity:.92}.hero-banner .cta-button,.sv-hero-daily__frame .sv-hero-daily__cta{background:#fff!important;color:#111!important;border-radius:7px;padding:9px 16px!important;font-size:12px!important;font-weight:600!important;letter-spacing:.14em;line-height:1}@media (min-width:768px){.hero-banner:has(img[src*="185102"]),.sv-hero-daily__frame:has(img[src*="185102"]){height:560px}.hero-banner:has(img[src*="185102"]) img,.sv-hero-daily__frame:has(img[src*="185102"]) img{transform:scale(1.3);transform-origin:62% 56%}.hero-banner::after,.sv-hero-daily__frame::after{background:linear-gradient(90deg,rgba(0,0,0,.7) 0%,rgba(0,0,0,.25) 45%,rgba(0,0,0,0) 65%)}.hero-content,.sv-hero-daily__content{top:50%!important;bottom:auto;left:6%!important;right:auto;max-width:46%!important;transform:translateY(-50%)!important}.hero-content p,.sv-hero-daily__content p{font-size:17px!important;margin-bottom:20px!important}.hero-banner .cta-button,.sv-hero-daily__frame .sv-hero-daily__cta{font-size:13px!important;padding:11px 20px!important}}html.sv-ani .hero-content,html.sv-ani .sv-hero-daily__content{opacity:0;translate:0 14px;transition:opacity .8s ease,translate .8s cubic-bezier(.2,.7,.2,1)}html.sv-ani .sv-visto{opacity:1;translate:0 0}@media (prefers-reduced-motion:reduce){html.sv-ani .hero-content,html.sv-ani .sv-hero-daily__content{transition:none}}</style>
<script>try{if('IntersectionObserver'in window&&!matchMedia('(prefers-reduced-motion: reduce)').matches){document.documentElement.classList.add('sv-ani');document.addEventListener('DOMContentLoaded',function(){var io=new IntersectionObserver(function(es){es.forEach(function(e){if(e.isIntersecting){e.target.classList.add('sv-visto');io.unobserve(e.target)}})},{threshold:.3});document.querySelectorAll('.hero-content,.sv-hero-daily__content').forEach(function(el){io.observe(el)})})}}catch(e){document.documentElement.classList.remove('sv-ani')}</script>
{%- endif -%}
