{%- comment -%} Menu del telefono como gasper.co: ver docs/tema.md. {%- endcomment -%}
{%- liquid
  assign m = 'prueba'
  for e in shop.metaobjects.sv_configuracion_2.values
    assign m = e.menu_tarjetas.value | default: 'prueba' | append: ''
    break
  endfor
-%}
{%- if m != 'no' -%}
<script>window.svMenu={m:{{ m | json }},f:{ {%- for l in linklists['main-menu'].links -%}{%- assign c = nil -%}{%- if l.type == 'collection_link' -%}{%- assign c = l.object -%}{%- elsif l.url contains '/collections/' -%}{%- assign h = l.url | split: '/collections/' | last | split: '?' | first | split: '/' | first -%}{%- assign c = collections[h] -%}{%- endif -%}{%- assign k = c.handle -%}{%- if k contains 'essentials' -%}{%- assign k = 'essentials' -%}{%- endif -%}{%- assign n = 'sv-menu-' | append: k | append: '.jpg' -%}{%- assign mf = images[n] -%}{%- if mf != blank -%}{{ l.url | json }}:{{ mf | image_url: width: 240 | json }},{%- elsif c.image -%}{{ l.url | json }}:{{ c.image | image_url: width: 240 | json }},{%- endif -%}{%- endfor -%}"":""},h:{ {%- assign ks = 'cadenas,pulseras,anillos,colgantes,conjuntos,best-sellers,essentials' | split: ',' -%}{%- for k in ks -%}{%- assign n = 'sv-menu-' | append: k | append: '.jpg' -%}{%- assign mf = images[n] -%}{%- if mf != blank -%}{{ k | json }}:{{ mf | image_url: width: 240 | json }},{%- endif -%}{%- endfor -%}"":""}};</script>
<link rel="stylesheet" href="{{ 'sv-menu.css' | asset_url }}"><script src="{{ 'sv-menu.js' | asset_url }}" async></script>
{%- endif -%}
