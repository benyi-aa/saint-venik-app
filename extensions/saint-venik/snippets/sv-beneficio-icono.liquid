{%- comment -%} docs/bloques.md: «sv-beneficio-icono.liquid · 1» {%- endcomment -%}

{%- liquid
  assign sv_img = b.icono_imagen.value
  assign sv_clase = clase | default: 'sv-benef__icono sv-benef__icono--img'
-%}

{%- if sv_img != blank -%}
  {%- comment -%} docs/bloques.md: «sv-beneficio-icono.liquid · 2» {%- endcomment -%}
  {%- if sv_img.url != blank -%}
    <img class="{{ sv_clase }}" src="{{ sv_img.url }}" alt="" loading="lazy" width="24" height="24" />
  {%- else -%}
    <img class="{{ sv_clase }}" src="{{ sv_img | image_url: width: 48 }}" alt="" loading="lazy" width="24" height="24" />
  {%- endif -%}
{%- else -%}
  {%- render 'sv-icono', nombre: b.icono.value -%}
{%- endif -%}
