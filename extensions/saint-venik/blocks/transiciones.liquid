{%- comment -%} Saint Venik · Transiciones entre paginas (barra LV, fundido, precarga). Explicacion: docs/tema.md. {%- endcomment -%}

{%- liquid
  assign cfg = null
  for sv_entrada in shop.metaobjects.sv_configuracion.values
    assign cfg = sv_entrada
    break
  endfor

  assign t_modo = cfg.trans_activo.value | default: 'no' | append: ''
  assign t_color = cfg.trans_color.value | default: '#999999' | append: ''
  assign t_grosor = cfg.trans_grosor.value | default: 2
  assign t_fundido = cfg.trans_fundido.value | default: 250
  assign t_precarga = true
  if cfg.trans_precarga.value == 'no'
    assign t_precarga = false
  endif
-%}

{%- comment -%} Va aqui por ser lo unico en <head>: ver el snippet. {%- endcomment -%}
{%- render 'sv-desc-estilo', cfg: cfg -%}
{%- render 'sv-cajon', cfg: cfg -%}
{%- render 'sv-portada', cfg: cfg, tt: block.settings.temporada_tema -%}
{%- render 'sv-menu' -%}
{%- render 'sv-inicio', tt: block.settings.temporada_tema -%}

{%- if t_modo == 'si' or t_modo == 'prueba' -%}
  <style>
    {%- if t_modo == 'si' %}
    @view-transition { navigation: auto; }
    {%- endif %}
    ::view-transition-group(*),
    ::view-transition-old(*),
    ::view-transition-new(*) {
      animation-duration: {{ t_fundido }}ms;
      animation-timing-function: ease;
    }
    /* La barra pasa por encima del cambio tal cual esta, sin fundirse. */
    ::view-transition-group(sv-barra),
    ::view-transition-new(sv-barra) { animation: none; }
    ::view-transition-old(sv-barra) { display: none; }
    @media (prefers-reduced-motion: reduce) {
      ::view-transition-group(*),
      ::view-transition-old(*),
      ::view-transition-new(*) { animation: none !important; }
    }
    .sv-barra {
      position: fixed;
      top: 0;
      left: 0;
      z-index: 2147483000;
      width: 100%;
      height: {{ t_grosor }}px;
      background: {{ t_color }};
      transform: scaleX(0);
      transform-origin: 0 50%;
      opacity: 0;
      pointer-events: none;
      view-transition-name: sv-barra;
    }
    .sv-barra.is-cargando {
      opacity: 1;
      transform: scaleX(.9);
      transition: transform 5s cubic-bezier(.1, .1, .2, 1) .25s, opacity 0s .25s;
    }
    .sv-barra.is-viene { opacity: 1; transition: none; }
    .sv-barra.is-listo {
      opacity: 0;
      transform: scaleX(1);
      transition: transform .25s ease-out, opacity .3s ease .3s;
    }
  </style>
  {%- comment -%} Diagnostico de la barra, solo con ?sv-diag=1: ver docs/tema.md. {%- endcomment -%}
  <script>try{/[?&]sv-diag=1/.test(location.search)&&sessionStorage.setItem('sv-diag','1');sessionStorage.getItem('sv-diag')==='1'&&document.write('<scr'+'ipt src="{{ 'sv-diag.js' | asset_url }}"></scr'+'ipt>')}catch(e){}</script>
  <script>
    (function () {
      'use strict';
      var modo = {{ t_modo | json }};
      var CLAVE = 'sv-barra';
      var guardar = function (k, v) { try { sessionStorage.setItem(k, v); } catch (e) { /* privado */ } };
      var leer = function (k) { try { return sessionStorage.getItem(k); } catch (e) { return null; } };

      if (/[?&]sv-vista(=1)?(&|$)/.test(location.search)) guardar('sv-vista', '1');
      /* Safari sin precarga: ver docs/tema.md, «La barra en el iPhone». */
      var hs = window.HTMLScriptElement, ua = navigator.userAgent;
      var lento = (leer('sv-lento') === '1' || !(hs && hs.supports && hs.supports('speculationrules'))
        || /AppleWebKit/.test(ua) && !/Chrom|Edg|OPR|Android/.test(ua));
      var prog = 0, paso = null, ya = 0;

      if (modo === 'prueba') {
        if (leer('sv-vista') !== '1') return;
        /* En vista previa el fundido se enciende desde aqui. */
        var st = document.createElement('style');
        st.textContent = '@view-transition { navigation: auto; }';
        document.head.appendChild(st);
      }

      var barra = null;
      /* Bajo la cabecera (logo, buscador, carrito) si se ve; si no, arriba. */
      function laBarra() {
        if (!barra) {
          barra = document.createElement('div');
          barra.className = 'sv-barra';
          barra.setAttribute('aria-hidden', 'true');
          document.body.appendChild(barra);
        }
        /* Con el menu o el carrito abiertos, bajo el encabezado del cajon y de su
           ancho: si no, cruza el menu por la mitad (video del 9-nov). */
        var dr = document.querySelector('.drawer.drawer--is-open');
        if (dr) {
          var rd = dr.getBoundingClientRect(), dh = dr.querySelector('.drawer__header');
          barra.style.top = Math.round(dh ? dh.getBoundingClientRect().bottom : rd.top) + 'px';
          barra.style.left = Math.round(rd.left) + 'px';
          barra.style.width = Math.round(rd.width) + 'px';
          return barra;
        }
        barra.style.left = '';
        barra.style.width = '';
        var h = document.getElementById('SiteHeader'), r = h && h.getBoundingClientRect();
        barra.style.top = (r && r.bottom > 0 && r.bottom < innerHeight / 2 ? Math.round(r.bottom) : 0) + 'px';
        return barra;
      }

      var tope = null;
      function empezar() {
        if (!document.body || Date.now() - ya < 400) return;
        ya = Date.now();
        var b = laBarra();
        b.style.transform = '';
        b.className = 'sv-barra';
        void b.offsetWidth; /* que arranque desde cero aunque ya estuviera */
        clearTimeout(paso);
        if (lento) {
          var t0 = Date.now();
          b.className = 'sv-barra is-viene';
          (function avanzar() {
            prog = .9 - .82 * Math.exp((t0 - Date.now()) / 5000);
            b.style.transform = 'scaleX(' + prog + ')';
            paso = setTimeout(avanzar, 60);
          })();
        } else {
          b.className = 'sv-barra is-cargando';
        }
        /* Si la navegacion no ocurre, que no se quede colgada. */
        clearTimeout(tope);
        tope = setTimeout(terminar, 10000);
      }

      function terminar() {
        clearTimeout(tope);
        clearTimeout(paso);
        paso = null;
        if (!barra) return;
        barra.style.transform = '';
        barra.className = 'sv-barra is-listo';
      }

      /* Al irse: por donde iba la barra, para que la pagina nueva siga de ahi. */
      function alIrse() {
        var p = 0;
        if (barra && /is-cargando/.test(barra.className)) {
          var cs = getComputedStyle(barra);
          var m = /matrix\(([^,]+)/.exec(cs.transform);
          if (cs.opacity !== '0' && m) p = Number(m[1]);
          /* Minimo 30 %: con precarga la pagina llega antes de que salga. */
          if (p < .3) p = .3;
        } else if (paso) {
          p = Math.max(prog, .3);
        }
        guardar(CLAVE, p > 0.02 ? Date.now() + ':' + p.toFixed(3) : '');
      }

      /* Solo navegaciones de verdad a otra pagina de la tienda. */
      function cuenta(url) {
        try {
          var u = new URL(url, location.href);
          if (u.origin !== location.origin) return false;
          if (u.pathname === location.pathname && u.search === location.search) return false;
          return !/^\/(cart|checkout|checkouts|account)(\/|$)/.test(u.pathname.replace(/^\/[a-z]{2}(-[a-z]{2})?(?=\/)/i, ''));
        } catch (e) {
          return false;
        }
      }

      if (window.navigation && window.navigation.addEventListener) {
        /* Captura tambien las que hace un script (location.href = ...). */
        window.navigation.addEventListener('navigate', function (e) {
          if (e.hashChange || e.downloadRequest || (e.destination && e.destination.sameDocument)) return;
          if (e.navigationType === 'reload' || e.navigationType === 'traverse') return;
          if (e.destination && cuenta(e.destination.url)) empezar();
        });
      }
      if (!window.navigation || lento) {
        /* Al final de la burbuja: si el tema cancelo el clic, no hay navegacion. */
        window.addEventListener('click', function (e) {
          if (e.defaultPrevented || e.button !== 0 || e.metaKey || e.ctrlKey || e.shiftKey || e.altKey) return;
          var a = e.target.closest && e.target.closest('a[href]');
          if (!a || a.target && a.target !== '_self' || a.hasAttribute('download')) return;
          if (cuenta(a.href)) empezar();
        });
      }

      /* La pagina nueva recoge la barra donde quedo y la acaba. */
      var dato = (leer(CLAVE) || '').split(':');
      var viene = Number(dato[1]) || 0;
      guardar(CLAVE, '');
      if (!(Number(dato[0]) && Date.now() - Number(dato[0]) < 15000)) viene = 0;
      function recoger() {
        if (!viene || !document.body) return;
        var b = laBarra();
        b.className = 'sv-barra is-viene';
        b.style.transform = 'scaleX(' + viene + ')';
        viene = 0;
        requestAnimationFrame(function () {
          requestAnimationFrame(terminar);
        });
      }
      window.addEventListener('pagereveal', recoger);
      document.addEventListener('DOMContentLoaded', recoger);
      /* Si se pinto antes de existir la cabecera, se recoloca. */
      document.addEventListener('DOMContentLoaded', function () { if (barra) laBarra(); });

      /* Lo que no se mueve al cambiar de pagina, si esta a la vista. */
      var QUIETOS = [['.svcd', 'sv-aviso'], ['#SiteHeader', 'sv-cabecera']];
      function nombrar(poner) {
        QUIETOS.forEach(function (q) {
          var el = document.querySelector(q[0]);
          if (!el) return;
          var r = el.getBoundingClientRect();
          el.style.viewTransitionName = poner && r.height && r.bottom > 0 && r.top < innerHeight ? q[1] : '';
        });
      }
      /* Si el navegador se salta el cambio, que el rechazo no salga en la consola. */
      function callar(vt) {
        [vt.ready, vt.updateCallbackDone].forEach(function (p) {
          if (p && p.catch) p.catch(function () {});
        });
      }
      window.addEventListener('pageswap', function (e) {
        alIrse();
        if (!e.viewTransition) return;
        callar(e.viewTransition);
        nombrar(true);
      });
      window.addEventListener('pagehide', alIrse);
      window.addEventListener('pagereveal', function (e) {
        if (!e.viewTransition) return;
        callar(e.viewTransition);
        nombrar(true);
        e.viewTransition.finished.then(function () { nombrar(false); }, function () { nombrar(false); });
      });

      /* Volver atras restaura la pagina tal cual estaba, con la barra a medias. */
      window.addEventListener('pageshow', function (e) {
        if (e.persisted) terminar();
      });
    }());
  </script>

  {%- if t_precarga -%}
    {%- comment -%} Precarga al apoyar el dedo o el raton; nunca carrito, cuenta ni pago. {%- endcomment -%}
    <script type="speculationrules">
      {
        "prefetch": [{
          "where": {
            "and": [
              { "href_matches": "/*" },
              { "not": { "href_matches": ["/cart*", "/checkout*", "/checkouts/*", "/account*", "/*/cart*", "/*/account*", "/apps/*", "/services/*"] } },
              { "not": { "selector_matches": "[target=_blank], [download], [data-no-prefetch], [href*='add']" } }
            ]
          },
          "eagerness": "moderate"
        }]
      }
    </script>
  {%- endif -%}
{%- endif -%}

{% schema %}
{
  "name": "Transiciones de página",
  "target": "head",
  "settings": [
    {
      "type": "paragraph",
      "content": "La barra de carga, el fundido entre páginas y la precarga se configuran en la app Color & Size Picker → Apariencia. Aquí solo se enciende el embed."
    },
    {
      "type": "select",
      "id": "temporada_tema",
      "label": "Temporada de este tema",
      "info": "Normalmente «La del panel». «Navidad» deja ESTE tema siempre en Navidad (para un tema de vista previa).",
      "default": "panel",
      "options": [
        { "value": "panel", "label": "La del panel" },
        { "value": "normal", "label": "Normal" },
        { "value": "navidad", "label": "Navidad" }
      ]
    }
  ]
}
{% endschema %}
