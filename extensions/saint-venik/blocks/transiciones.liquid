{%- comment -%}
  Saint Venik · Transiciones entre paginas
  ---------------------------------------------------------------------------
  Calcado de louisvuitton.com (llamada del 6-nov, minuto 0:25 del video): al
  tocar un enlace sale arriba una barra gris muy fina que se llena lento y
  parejo, el encabezado no se mueve y solo cambia lo de abajo. Cuatro piezas,
  todas sin dependencias:

    1. La barra. Sale un cuarto de segundo despues del toque (si la pagina
       llega antes, ni aparece) y se llena hacia el 90 % con la curva medida
       en el video: 20 % al segundo, 35 % al segundo y algo. Al irse, la
       pagina guarda por donde iba; la nueva la recoge ahi y la termina. Se
       lee como una sola barra aunque son dos documentos.
    2. El fundido: `@view-transition { navigation: auto }`, la transicion
       entre documentos del propio navegador. Donde no existe (Firefox), la
       pagina cambia como siempre y la barra sigue funcionando.
    3. Lo quieto: durante el cambio, la cuenta regresiva y el encabezado
       llevan nombre (view-transition-name), y el navegador los deja en su
       sitio en vez de fundirlos con el resto. Solo si estan a la vista.
    4. La precarga: reglas de especulacion. Al apoyar el dedo o el raton
       sobre un enlace, el navegador ya pide esa pagina. El carrito, la
       cuenta y el pago quedan fuera.

  Es un embed de <head> porque todo eso tiene que estar antes del primer
  pintado de la pagina nueva.

  Todo se controla desde la app (pantalla Apariencia). Tres estados, como el
  descuento: 'si', 'no' y 'prueba' (solo con ?sv-vista=1).
{%- endcomment -%}

{%- liquid
  assign cfg = null
  for sv_entrada in shop.metaobjects.sv_configuracion.values
    assign cfg = sv_entrada
    break
  endfor

  assign t_modo = cfg.trans_activo.value | default: 'no' | append: ''
  assign t_color = cfg.trans_color.value | default: '#999999' | append: ''
  assign t_grosor = cfg.trans_grosor.value | default: 2
  assign t_fundido = cfg.trans_fundido.value | default: 250
  assign t_precarga = true
  if cfg.trans_precarga.value == 'no'
    assign t_precarga = false
  endif
-%}

{%- comment -%} Va aqui por ser lo unico en <head>: ver el snippet. {%- endcomment -%}
{%- render 'sv-desc-estilo', cfg: cfg -%}

{%- if t_modo == 'si' or t_modo == 'prueba' -%}
  <style>
    {%- if t_modo == 'si' %}
    @view-transition { navigation: auto; }
    {%- endif %}
    ::view-transition-group(*),
    ::view-transition-old(*),
    ::view-transition-new(*) {
      animation-duration: {{ t_fundido }}ms;
      animation-timing-function: ease;
    }
    /* La barra pasa por encima del cambio tal cual esta, sin fundirse. */
    ::view-transition-group(sv-barra),
    ::view-transition-new(sv-barra) { animation: none; }
    ::view-transition-old(sv-barra) { display: none; }
    @media (prefers-reduced-motion: reduce) {
      ::view-transition-group(*),
      ::view-transition-old(*),
      ::view-transition-new(*) { animation: none !important; }
    }
    .sv-barra {
      position: fixed;
      top: 0;
      left: 0;
      z-index: 2147483000;
      width: 100%;
      height: {{ t_grosor }}px;
      background: {{ t_color }};
      transform: scaleX(0);
      transform-origin: 0 50%;
      opacity: 0;
      pointer-events: none;
      view-transition-name: sv-barra;
    }
    .sv-barra.is-cargando {
      opacity: 1;
      transform: scaleX(.9);
      transition: transform 5s cubic-bezier(.1, .1, .2, 1) .25s, opacity 0s .25s;
    }
    .sv-barra.is-viene { opacity: 1; transition: none; }
    .sv-barra.is-listo {
      opacity: 0;
      transform: scaleX(1);
      transition: transform .25s ease-out, opacity .3s ease .3s;
    }
  </style>
  <script>
    (function () {
      'use strict';
      var modo = {{ t_modo | json }};
      var CLAVE = 'sv-barra';
      var guardar = function (k, v) { try { sessionStorage.setItem(k, v); } catch (e) { /* privado */ } };
      var leer = function (k) { try { return sessionStorage.getItem(k); } catch (e) { return null; } };

      if (modo === 'prueba') {
        if (/[?&]sv-vista(=1)?(&|$)/.test(location.search)) guardar('sv-vista', '1');
        if (leer('sv-vista') !== '1') return;
        /* En vista previa el fundido se enciende desde aqui. */
        var st = document.createElement('style');
        st.textContent = '@view-transition { navigation: auto; }';
        document.head.appendChild(st);
      }

      var barra = null;
      function laBarra() {
        if (barra) return barra;
        barra = document.createElement('div');
        barra.className = 'sv-barra';
        barra.setAttribute('aria-hidden', 'true');
        document.body.appendChild(barra);
        return barra;
      }

      var tope = null;
      function empezar() {
        if (!document.body) return;
        var b = laBarra();
        b.style.transform = '';
        b.className = 'sv-barra';
        void b.offsetWidth; /* que arranque desde cero aunque ya estuviera */
        b.className = 'sv-barra is-cargando';
        /* Si la navegacion no ocurre (la corto el usuario, o un script la
         * cancelo), la barra no se queda colgada. */
        clearTimeout(tope);
        tope = setTimeout(terminar, 10000);
      }

      function terminar() {
        clearTimeout(tope);
        if (!barra) return;
        barra.style.transform = '';
        barra.className = 'sv-barra is-listo';
      }

      /* Al irse: por donde iba la barra, para que la pagina nueva siga de ahi. */
      function alIrse() {
        var p = 0;
        if (barra && /is-cargando/.test(barra.className)) {
          var cs = getComputedStyle(barra);
          var m = /matrix\(([^,]+)/.exec(cs.transform);
          if (cs.opacity !== '0' && m) p = Number(m[1]);
          /* Con la precarga la pagina llega antes del cuarto de segundo y la
           * barra no salia nunca: la nueva la acaba siempre, desde un 30 %. */
          if (p < .3) p = .3;
        }
        guardar(CLAVE, p > 0.02 ? Date.now() + ':' + p.toFixed(3) : '');
      }

      /* Solo navegaciones de verdad a otra pagina de la tienda. */
      function cuenta(url) {
        try {
          var u = new URL(url, location.href);
          if (u.origin !== location.origin) return false;
          if (u.pathname === location.pathname && u.search === location.search) return false;
          return !/^\/(cart|checkout|checkouts|account)(\/|$)/.test(u.pathname.replace(/^\/[a-z]{2}(-[a-z]{2})?(?=\/)/i, ''));
        } catch (e) {
          return false;
        }
      }

      if (window.navigation && window.navigation.addEventListener) {
        /* Captura tambien las que hace un script (location.href = ...). */
        window.navigation.addEventListener('navigate', function (e) {
          if (e.hashChange || e.downloadRequest || (e.destination && e.destination.sameDocument)) return;
          if (e.navigationType === 'reload' || e.navigationType === 'traverse') return;
          if (e.destination && cuenta(e.destination.url)) empezar();
        });
      } else {
        /* Al final de la burbuja: si el tema ya cancelo el clic (abre el
         * carrito en un cajon, por ejemplo), no hay navegacion. */
        window.addEventListener('click', function (e) {
          if (e.defaultPrevented || e.button !== 0 || e.metaKey || e.ctrlKey || e.shiftKey || e.altKey) return;
          var a = e.target.closest && e.target.closest('a[href]');
          if (!a || a.target && a.target !== '_self' || a.hasAttribute('download')) return;
          if (cuenta(a.href)) empezar();
        });
      }

      /* La pagina nueva recoge la barra donde la dejo la anterior y la acaba.
       * En el primer pintado (pagereveal) si el navegador lo tiene, para que
       * la barra ya este en el cambio; si no, en cuanto exista el body. */
      var dato = (leer(CLAVE) || '').split(':');
      var viene = Number(dato[1]) || 0;
      guardar(CLAVE, '');
      if (!(Number(dato[0]) && Date.now() - Number(dato[0]) < 15000)) viene = 0;
      function recoger() {
        if (!viene || !document.body) return;
        var b = laBarra();
        b.className = 'sv-barra is-viene';
        b.style.transform = 'scaleX(' + viene + ')';
        viene = 0;
        requestAnimationFrame(function () {
          requestAnimationFrame(terminar);
        });
      }
      window.addEventListener('pagereveal', recoger);
      document.addEventListener('DOMContentLoaded', recoger);

      /* Lo que no se mueve al cambiar de pagina, si esta a la vista. */
      var QUIETOS = [['.svcd', 'sv-aviso'], ['#SiteHeader', 'sv-cabecera']];
      function nombrar(poner) {
        QUIETOS.forEach(function (q) {
          var el = document.querySelector(q[0]);
          if (!el) return;
          var r = el.getBoundingClientRect();
          el.style.viewTransitionName = poner && r.height && r.bottom > 0 && r.top < innerHeight ? q[1] : '';
        });
      }
      window.addEventListener('pageswap', function (e) {
        alIrse();
        if (e.viewTransition) nombrar(true);
      });
      window.addEventListener('pagehide', alIrse);
      window.addEventListener('pagereveal', function (e) {
        if (!e.viewTransition) return;
        nombrar(true);
        e.viewTransition.finished.then(function () { nombrar(false); }, function () { nombrar(false); });
      });

      /* Volver atras restaura la pagina tal cual estaba, con la barra a medias. */
      window.addEventListener('pageshow', function (e) {
        if (e.persisted) terminar();
      });
    }());
  </script>

  {%- if t_precarga -%}
    {%- comment -%}
      Precarga al apoyar el dedo o el raton («moderate»). Fuera: carrito,
      cuenta, pago, apps de terceros y cualquier enlace que abra otra
      pestana o que alguien marque con data-no-prefetch.
    {%- endcomment -%}
    <script type="speculationrules">
      {
        "prefetch": [{
          "where": {
            "and": [
              { "href_matches": "/*" },
              { "not": { "href_matches": ["/cart*", "/checkout*", "/checkouts/*", "/account*", "/*/cart*", "/*/account*", "/apps/*", "/services/*"] } },
              { "not": { "selector_matches": "[target=_blank], [download], [data-no-prefetch], [href*='add']" } }
            ]
          },
          "eagerness": "moderate"
        }]
      }
    </script>
  {%- endif -%}
{%- endif -%}

{% schema %}
{
  "name": "Transiciones de página",
  "target": "head",
  "settings": [
    {
      "type": "paragraph",
      "content": "La barra de carga, el fundido entre páginas y la precarga se configuran en la app Color & Size Picker → Apariencia. Aquí solo se enciende el embed."
    }
  ]
}
{% endschema %}
