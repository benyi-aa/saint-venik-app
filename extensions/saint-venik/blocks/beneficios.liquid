{%- comment -%} docs/bloques.md: «beneficios.liquid · 1» {%- endcomment -%}

{%- if product != blank -%}
  {%- liquid
    assign lang = localization.language.iso_code | slice: 0, 2 | downcase

    # nota 1: docs/bloques.md
    assign marca = product.id | prepend: '|' | append: '|'
    assign marca_handle = product.handle | prepend: '|' | append: '|'

    # nota 2: docs/bloques.md
    assign config = null
    for sv_entrada in shop.metaobjects.sv_configuracion.values
      assign config = sv_entrada
      break
    endfor
    assign sv_escala = config.escala.value | default: 'normal'

    assign todos = shop.metaobjects.sv_beneficio.values

    # nota 3: docs/bloques.md
    assign visibles = 0
    assign tope = 0
    for b in todos
      assign hs = b.handles.value | default: ''
      assign alcanza = false
      if hs contains marca or hs contains marca_handle
        assign alcanza = true
      endif
      if b.activo.value != false and alcanza
        assign visibles = visibles | plus: 1
        assign pos = b.orden.value | default: 0
        if pos > tope
          assign tope = pos
        endif
      endif
    endfor
  -%}

  {%- if visibles > 0 -%}
    {%- liquid
      assign titulo = block.settings.titulo_es
      if lang == 'en' and block.settings.titulo_en != blank
        assign titulo = block.settings.titulo_en
      endif
      assign maximo = block.settings.maximo
    -%}

    <div class="sv-benef sv-benef--{{ block.settings.estilo }} sv-benef--{{ block.settings.disposicion }} sv-benef--{{ sv_escala }}"
      style="
        --sv-benef-fondo: {{ block.settings.color_fondo }};
        --sv-benef-texto: {{ block.settings.color_texto }};
        --sv-benef-borde: {{ block.settings.color_borde }};
        --sv-benef-radio: {{ block.settings.radio }}px;
        --sv-pt: {{ block.settings.margen_superior }}px;
        --sv-pb: {{ block.settings.margen_inferior }}px;
      "
      {{ block.shopify_attributes }}>
      {%- if titulo != blank -%}
        <p class="sv-benef__titulo">{{ titulo }}</p>
      {%- endif -%}

      <ul class="sv-benef__lista" role="list">
        {%- assign puestos = 0 -%}

        {%- for i in (1..tope) -%}
          {%- for b in todos -%}
            {%- if puestos < maximo and b.orden.value == i -%}
              {%- assign hs = b.handles.value | default: '' -%}
              {%- if hs contains marca or hs contains marca_handle -%}
                {%- if b.activo.value != false -%}
                  {%- render 'sv-beneficio-item', b: b, lang: lang -%}
                  {%- assign puestos = puestos | plus: 1 -%}
                {%- endif -%}
              {%- endif -%}
            {%- endif -%}
          {%- endfor -%}
        {%- endfor -%}

        {%- comment -%} Los que no tengan posicion van al final, no se pierden. {%- endcomment -%}
        {%- for b in todos -%}
          {%- assign pos = b.orden.value | default: 0 -%}
          {%- if puestos < maximo and pos < 1 -%}
            {%- assign hs = b.handles.value | default: '' -%}
            {%- if hs contains marca or hs contains marca_handle -%}
              {%- if b.activo.value != false -%}
                {%- render 'sv-beneficio-item', b: b, lang: lang -%}
                {%- assign puestos = puestos | plus: 1 -%}
              {%- endif -%}
            {%- endif -%}
          {%- endif -%}
        {%- endfor -%}
      </ul>
    </div>
  {%- endif -%}
{%- endif -%}

{% schema %}
{
  "name": "Beneficios",
  "target": "section",
  "stylesheet": "sv-benefits.css",
  "enabled_on": {
    "templates": ["product"]
  },
  "settings": [
    {
      "type": "paragraph",
      "content": "Los beneficios y a qué productos alcanza cada uno se eligen en la app, en la pantalla «Beneficios». Si el producto no tiene ninguno, el bloque no se muestra."
    },
    {
      "type": "range",
      "id": "maximo",
      "label": "Cuántos mostrar como mucho",
      "min": 1,
      "max": 6,
      "step": 1,
      "default": 3
    },
    {
      "type": "select",
      "id": "estilo",
      "label": "Estilo",
      "options": [
        { "value": "pildora", "label": "Píldora — cada uno en su contenedor" },
        { "value": "plano", "label": "Plano — solo icono y texto" }
      ],
      "default": "pildora"
    },
    {
      "type": "select",
      "id": "disposicion",
      "label": "Disposición",
      "options": [
        { "value": "fila", "label": "En fila" },
        { "value": "columna", "label": "Uno debajo de otro" }
      ],
      "default": "fila"
    },
    {
      "type": "header",
      "content": "Título (opcional)"
    },
    {
      "type": "text",
      "id": "titulo_es",
      "label": "Título en español"
    },
    {
      "type": "text",
      "id": "titulo_en",
      "label": "Título en inglés"
    },
    {
      "type": "header",
      "content": "Aspecto"
    },
    {
      "type": "color",
      "id": "color_fondo",
      "label": "Fondo de la píldora",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "color_texto",
      "label": "Texto e icono",
      "default": "#111111"
    },
    {
      "type": "color",
      "id": "color_borde",
      "label": "Borde",
      "info": "Sobre fondo blanco, sin borde la píldora no se ve.",
      "default": "#E4DFD7"
    },
    {
      "type": "range",
      "id": "radio",
      "label": "Redondeo",
      "min": 0,
      "max": 24,
      "step": 1,
      "unit": "px",
      "default": 8
    },
    {
      "type": "range",
      "id": "margen_superior",
      "label": "Margen superior",
      "min": 0,
      "max": 48,
      "step": 2,
      "unit": "px",
      "default": 12
    },
    {
      "type": "range",
      "id": "margen_inferior",
      "label": "Margen inferior",
      "min": 0,
      "max": 48,
      "step": 2,
      "unit": "px",
      "default": 10
    }
  ]
}
{% endschema %}
