{%- assign s = section.settings -%}
{{ 'sv-3x2.css' | asset_url | stylesheet_tag }}
<section class="sv3 sv3-inc" style="--sv3-bg:{{ s.bg }};--sv3-text:{{ s.text }};--sv3-pt:{{ s.pad_top }}px;--sv3-pb:{{ s.pad_bottom }}px">
<div class="sv3-wrap">
{%- if s.heading != blank -%}<h2 class="sv3-h">{% render 'sv3-t', t: s.heading %}</h2>{%- endif -%}
<ul class="sv3-inc__list">
{%- for block in section.blocks -%}
<li {{ block.shopify_attributes }}>
{%- if block.settings.icon != 'none' -%}{%- render 'sv3-icon', icon: block.settings.icon -%}{%- endif -%}
<div><strong>{% render 'sv3-t', t: block.settings.title %}</strong>
{%- if block.settings.text != blank -%}<span>{% render 'sv3-t', t: block.settings.text %}</span>{%- endif -%}</div>
</li>
{%- endfor -%}
</ul>
</div>
</section>
{% schema %}{"name":"3x2 · Qué incluye","tag":"div","class":"sv3-section","settings":[{"type":"text","id":"heading","label":"Título","default":"Qué incluye tu 3x2"},{"type":"color","id":"bg","label":"Fondo","default":"#f5f0e8"},{"type":"color","id":"text","label":"Texto","default":"#1a1714"},{"type":"range","id":"pad_top","label":"Espacio superior","min":0,"max":100,"step":4,"unit":"px","default":56},{"type":"range","id":"pad_bottom","label":"Espacio inferior","min":0,"max":100,"step":4,"unit":"px","default":56}],"blocks":[{"type":"item","name":"Ítem","limit":6,"settings":[{"type":"select","id":"icon","label":"Ícono","default":"diamante","options":[{"value":"oro","label":"Oro"},{"value":"brillo","label":"No se destiñe"},{"value":"hoja","label":"Hipoalergénico"},{"value":"agua","label":"Agua y sudor"},{"value":"diamante","label":"Diamante"},{"value":"escudo","label":"Garantía"},{"value":"corazon","label":"Clientes"},{"value":"cuotas","label":"Cuotas"},{"value":"envio","label":"Envío"},{"value":"regalo","label":"Regalo"},{"value":"none","label":"Sin ícono"}]},{"type":"text","id":"title","label":"Título"},{"type":"text","id":"text","label":"Detalle"}]}],"presets":[{"name":"3x2 · Qué incluye"}]}{% endschema %}