{%- assign s = section.settings -%}
{%- assign lines = s.photos | newline_to_br | split: '<br />' -%}
{%- assign curated = false -%}{%- if section.blocks.size == 0 and s.photos != blank -%}{%- assign curated = true -%}{%- endif -%}
{{ 'sv-3x2.css' | asset_url | stylesheet_tag }}
<script src="{{ 'sv-3x2.js' | asset_url }}" defer></script>
<section class="sv3 sv3-galeria" {% if section.blocks.size == 0 and curated == false %}hidden{% endif %} style="--sv3-bg:{{ s.bg }};--sv3-text:{{ s.text }};--sv3-pt:{{ s.pad_top }}px;--sv3-pb:{{ s.pad_bottom }}px">
<div class="sv3-wrap sv3-head sv3-head--row">
<div>
{%- if s.kicker != blank -%}<p class="sv3-kicker">{{ s.kicker }}</p>{%- endif -%}
{%- if s.heading != blank -%}<h2 class="sv3-h">{{ s.heading }}</h2>{%- endif -%}
</div>
<div class="sv3-galnav">
<button type="button" data-sv3-galnav="-1" aria-label="Anterior"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="m15 5-7 7 7 7"/></svg></button>
<button type="button" data-sv3-galnav="1" aria-label="Siguiente"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="m9 5 7 7-7 7"/></svg></button>
</div>
</div>
<div class="sv3-gal"{% if section.blocks.size == 0 and curated == false %} data-sv3-gallery-auto data-count="{{ s.count }}"{% if s.show_names %} data-names{% endif %}{% endif %}>
{%- if curated -%}
{%- for line in lines -%}{%- assign parts = line | split: '|' -%}{%- assign u = parts[0] | strip -%}{%- if u != blank -%}
<figure><img src="{{ u | escape }}" alt="{{ parts[1] | strip | escape }}" loading="lazy">{%- if s.show_names and parts[1] != blank -%}<figcaption>{{ parts[1] | strip }}</figcaption>{%- endif -%}</figure>
{%- endif -%}{%- endfor -%}
{%- endif -%}
{%- for block in section.blocks -%}
<figure {{ block.shopify_attributes }}>
{%- if block.settings.image != blank -%}{{ block.settings.image | image_url: width: 600 | image_tag: loading: 'lazy', alt: block.settings.caption }}{%- else -%}{{ 'image' | placeholder_svg_tag }}{%- endif -%}
{%- if block.settings.caption != blank -%}<figcaption>{{ block.settings.caption }}</figcaption>{%- endif -%}
</figure>
{%- endfor -%}
</div>
</section>
