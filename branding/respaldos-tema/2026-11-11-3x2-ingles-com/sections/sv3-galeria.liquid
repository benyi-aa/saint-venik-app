 superior","min":0,"max":100,"step":4,"unit":"px","default":24},{"type":"range","id":"pad_bottom","label":"Espacio inferior","min":0,"max":100,"step":4,"unit":"px","default":48}],"blocks":[{"type":"foto","name":"Foto","limit":16,"settings":[{"type":"image_picker","id":"image","label":"Imagen"},{"type":"text","id":"caption","label":"Texto sobre la foto"}]}],"presets":[{"name":"3x2 · Así lo llevan"}]}{% endschema %}