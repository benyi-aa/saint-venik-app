{%- liquid
assign s = section.settings
assign sizes = s.preferred_sizes | split: ','
-%}
{{ 'sv-3x2.css' | asset_url | stylesheet_tag }}
<script src="{{ 'sv-3x2.js' | asset_url }}" defer></script>
<section class="sv3 sv3-grilla" id="sv3-grilla" data-sv3-grid-section
style="--sv3-bg:{{ s.bg }};--sv3-text:{{ s.text }};--sv3-btn:{{ s.btn }};--sv3-btn-text:{{ s.btn_text }};--sv3-sale:{{ s.sale }};--sv3-tag:{{ s.tag }};--sv3-pt:{{ s.pad_top }}px;--sv3-pb:{{ s.pad_bottom }}px;--sv3-cols:{{ s.columns }}">
<script type="application/json" data-sv3-config>
{
"moneyFormat": {{ shop.money_format | json }},
"preferredSizes": [{% for z in sizes %}{{ z | strip | json }}{% unless forloop.last %},{% endunless %}{% endfor %}],
"hideSoldOut": {{ s.hide_sold_out }},
"pairColors": {{ s.pair_colors }},
"showSaveTag": {{ s.show_save_tag }},
"hoverImage": {{ s.hover_image }},
"showDescription": {{ s.show_description }},
"showQuick": {{ s.show_quick }},
"benefitSelector": {{ s.benefit_selector | json }},
"t": {
"add": {{ s.t_add | json }}, "added": {{ s.t_added | json }}, "quick": {{ s.t_quick | json }}, "size": {{ s.t_size | json }},
"oro": {{ s.t_gold | json }}, "plata": {{ s.t_silver | json }}, "soldOut": {{ s.t_sold_out | json }}, "saveTag": {{ s.t_save_tag | json }},
"qvAdd": {{ s.t_qv_add | json }}, "desc": {{ s.t_desc | json }}, "full": {{ s.t_full | json }}, "guide": {{ s.t_guide | json }},
"addError": "No pudimos agregar las joyas. Intenta de nuevo.", "loadError": "No pudimos cargar esta colección. Intenta de nuevo.", "empty": "No hay joyas disponibles en esta colección."
}
}
</script>
<div class="sv3-banner" style="--sv3-banner-bg:{{ s.banner_bg }};--sv3-banner-text:{{ s.banner_text }};--sv3-steps:{{ s.steps_size }}px">
<div class="sv3-wrap">
{%- if s.heading != blank -%}<h2 class="sv3-banner__title">{{ s.heading }}</h2>{%- endif -%}
{%- if s.banner_sub != blank -%}<p class="sv3-banner__sub">{{ s.banner_sub }}</p>{%- endif -%}
{%- assign steps = section.blocks | where: 'type', 'paso' -%}
{%- if steps.size > 0 -%}
<ol class="sv3-steps">
{%- for block in steps -%}<li {{ block.shopify_attributes }}><b>{{ forloop.index }}</b><span>{{ block.settings.text }}</span></li>{%- endfor -%}
</ol>
{%- endif -%}
</div>
</div>
<div class="sv3-bar">
<div class="sv3-wrap sv3-bar__in">
<div class="sv3-tabs" role="tablist">
{%- for block in section.blocks -%}
{%- if block.type == 'coleccion' and block.settings.collection != blank -%}
<button type="button" role="tab" class="sv3-tab" data-sv3-tab="{{ block.settings.collection.handle }}" {{ block.shopify_attributes }}>{{ block.settings.label | default: block.settings.collection.title }}</button>
{%- endif -%}
{%- endfor -%}
</div>
<div class="sv3-bar__meta">
<span class="sv3-count" data-sv3-count data-format="{{ s.count_format | escape }}"></span>
<label class="sv3-sort"><span>{{ s.sort_label }}</span>
<select data-sv3-sort>
<option value="best">{{ s.sort_best }}</option>
<option value="asc">{{ s.sort_asc }}</option>
<option value="desc">{{ s.sort_desc }}</option>
</select>
</label>
</div>
</div>
</div>
<div class="sv3-wrap">
<div class="sv3-grid" data-sv3-grid></div>
{%- if s.note != blank -%}<p class="sv3-note">{{ s.note }}</p>{%- endif -%}
</div>
<div class="sv3-modal" data-sv3-modal role="dialog" aria-modal="true" style="--sv3-btn:{{ s.btn }};--sv3-btn-text:{{ s.btn_text }};--sv3-sale:{{ s.sale }};--sv3-tag:{{ s.tag }}">
<div class="sv3-modal__bg" data-sv3-close></div>
<div class="sv3-modal__box">
<button type="button" class="sv3-modal__close" data-sv3-close aria-label="Cerrar">×</button>
<div data-sv3-qvbody style="display:contents"></div>
</div>
</div>
</section>
{% schema %}{"name":"3x2 · Elige tus 3","tag":"div","class":"sv3-section","settings":[{"type":"header","content":"Franja de la oferta"},{"type":"text","id":"heading","label":"Título","default":"3X2 en todo"},{"type":"text","id":"banner_sub","label":"Bajada","default":"Elige 3 joyas y una va por nuestra cuenta"},{"type":"range","id":"steps_size","label":"Tamaño de los pasos","min":11,"max":22,"step":1,"unit":"px","default":15},{"type":"color","id":"banner_bg","label":"Fondo de la franja","default":"#ececec"},{"type":"color","id":"banner_text","label":"Texto de la franja","default":"#000000"},{"type":"header","content":"Grilla"},{"type":"range","id":"columns","label":"Productos por fila (computador)","min":3,"max":5,"step":1,"default":4},{"type":"text","id":"note","label":"Nota bajo la grilla","default":"Cada pieza incluye Garantía Eterna"},{"type":"header","content":"Orden"},{"type":"text","id":"count_format","label":"Contador de joyas","info":"{n} = cantidad de joyas de la pestaña","default":"{n} joyas"},{"type":"text","id":"sort_label","label":"Etiqueta","default":"Ordenar"},{"type":"text","id":"sort_best","label":"Opción 1 (orden de la colección)","default":"Más vendidos"},{"type":"text","id":"sort_asc","label":"Opción 2","default":"Precio: menor a mayor"},{"type":"text","id":"sort_desc","label":"Opción 3","default":"Precio: mayor a menor"},{"type":"header","content":"Funcionamiento"},{"type":"text","id":"preferred_sizes","label":"Medidas por defecto","info":"Separadas por coma, en orden de preferencia. Ej: 55CM, 20CM. Si se deja vacío se usa la primera disponible."},{"type":"checkbox","id":"pair_colors","label":"Unir versión Oro y Plateada en una sola tarjeta","default":true},{"type":"checkbox","id":"hide_sold_out","label":"Ocultar productos agotados","default":true},{"type":"checkbox","id":"show_save_tag","label":"Mostrar insignia «Ahorra %»","default":true},{"type":"checkbox","id":"hover_image","label":"Mostrar foto en uso al pasar el cursor","default":true},{"type":"checkbox","id":"show_description","label":"Mostrar descripción en la vista rápida","default":true},{"type":"checkbox","id":"show_quick","label":"Mostrar botón «Vista rápida» en las fotos","default":true},{"type":"text","id":"benefit_selector","label":"Beneficios de la vista rápida (avanzado)","info":"Se copian del bloque de beneficios de cada página de producto (oro, plateado o brillantes). No cambiar salvo que cambie ese bloque.","default":".benefit-list .benefit-item"},{"type":"header","content":"Textos de las tarjetas"},{"type":"text","id":"t_add","label":"Botón añadir","default":"Añadir"},{"type":"text","id":"t_added","label":"Insignia añadida","default":"En tu 3x2"},{"type":"text","id":"t_quick","label":"Vista rápida","default":"Vista rápida"},{"type":"text","id":"t_size","label":"Medida","default":"Medida"},{"type":"text","id":"t_gold","label":"Color oro","default":"Oro"},{"type":"text","id":"t_silver","label":"Color plateado","default":"Plateado"},{"type":"text","id":"t_sold_out","label":"Agotado","default":"Agotado"},{"type":"text","id":"t_save_tag","label":"Insignia de ahorro","info":"{n} = porcentaje","default":"Ahorra {n}%"},{"type":"text","id":"t_qv_add","label":"Botón en vista rápida","default":"Añadir a mi 3x2"},{"type":"text","id":"t_desc","label":"Descripción","default":"Descripción"},{"type":"text","id":"t_full","label":"Enlace a la ficha","default":"Ver ficha completa"},{"type":"text","id":"t_guide","label":"Guía de tallas (vista rápida)","info":"Se muestra la misma guía de la página de cada producto, según su categoría.","default":"Guía de tallas"},{"type":"header","content":"Colores y espacios"},{"type":"color","id":"bg","label":"Fondo","default":"#ffffff"},{"type":"color","id":"text","label":"Texto","default":"#1c1d1d"},{"type":"color","id":"btn","label":"Botones","default":"#000000"},{"type":"color","id":"btn_text","label":"Texto de botones","default":"#ffffff"},{"type":"color","id":"sale","label":"Precio de oferta","default":"#e32c2b"},{"type":"color","id":"tag","label":"Insignia «Ahorra %»","default":"#971d13"},{"type":"range","id":"pad_top","label":"Espacio superior","min":0,"max":100,"step":4,"unit":"px","default":40},{"type":"range","id":"pad_bottom","label":"Espacio inferior","min":0,"max":100,"step":4,"unit":"px","default":24}],"blocks":[{"type":"paso","name":"Paso","limit":4,"settings":[{"type":"text","id":"text","label":"Texto"}]},{"type":"coleccion","name":"Pestaña de colección","limit":12,"settings":[{"type":"collection","id":"collection","label":"Colección"},{"type":"text","id":"label","label":"Nombre en la pestaña","info":"Vacío = nombre de la colección"}]}],"presets":[{"name":"3x2 · Elige tus 3"}]}{% endschema %}