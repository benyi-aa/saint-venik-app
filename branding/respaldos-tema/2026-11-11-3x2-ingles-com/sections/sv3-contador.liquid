{%- assign s = section.settings -%}
{{ 'sv-3x2.css' | asset_url | stylesheet_tag }}
<script src="{{ 'sv-3x2.js' | asset_url }}" defer></script>
{%- if s.sticky -%}<style>#shopify-section-{{ section.id }}{position:sticky;top:0;z-index:40}</style>{%- endif -%}
<style>#shopify-section-{{ section.id }} .sv3-cd__bar i{background:color-mix(in srgb,var(--sv3-cd-text) 14%,transparent)}#shopify-section-{{ section.id }} .sv3-cd__bar i.on{background:var(--sv3-cd-acc)}{%- if s.border != blank -%}#shopify-section-{{ section.id }} .sv3-cd{border-bottom:1px solid {{ s.border }};box-shadow:0 4px 14px rgba(0,0,0,.05)}{%- endif -%}.sv3-cd__pulso{position:relative;flex:none;width:7px;height:7px;margin:0 3px 0 1px;border-radius:50%;background:var(--sv3-cd-urg)}.sv3-cd__pulso::after{content:'';position:absolute;inset:0;border-radius:50%;background:var(--sv3-cd-urg);animation:sv3-pulso 1.8s ease-out infinite}@keyframes sv3-pulso{0%{transform:scale(1);opacity:.6}80%,100%{transform:scale(3);opacity:0}}@media (prefers-reduced-motion:reduce){.sv3-cd__pulso::after{animation:none}}</style>
<div class="sv3-cd" data-sv3-cd data-mode="{{ s.mode }}" data-h="{{ s.end_hour }}" data-m="{{ s.end_minute }}" data-date="{{ s.end_date | escape }}" data-hide="{{ s.hide_when_done }}" data-ship="{{ s.free_shipping }}" data-m0="{{ s.msg_0 | escape }}" data-m1="{{ s.msg_1 | escape }}" data-m2="{{ s.msg_2 | escape }}" data-m3="{{ s.msg_3 | escape }}" data-s0="{{ s.ship_text | escape }}" data-s1="{{ s.ship_missing | escape }}" data-s2="{{ s.ship_ok | escape }}" style="--sv3-cd-bg:{{ s.bg }};--sv3-cd-text:{{ s.text }};--sv3-cd-acc:{{ s.accent }};--sv3-cd-urg:{{ s.urgency | default: s.accent }}">
<div class="sv3-cd__in">
<div class="sv3-cd__top"><p class="sv3-cd__title">{%- if s.urgency != blank -%}<span class="sv3-cd__pulso" aria-hidden="true"></span>{%- else -%}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><circle cx="12" cy="13" r="8"/><path d="M12 9v4l2.5 2.5M9.5 2.5h5"/></svg>{%- endif -%}{{ s.title }}</p><b class="sv3-cd__time" data-sv3-cd-t>00:00:00</b></div>
<div class="sv3-cd__prog"><div class="sv3-cd__bar"><i></i><i></i><i></i></div><span class="sv3-cd__n" data-sv3-progress data-format="{n}/3">0/3</span></div>
<p class="sv3-cd__msg"><span data-sv3-cd-msg>{{ s.msg_0 }}</span><span class="sv3-cd__ship" data-sv3-cd-ship>{{ s.ship_text }}</span></p>
</div>
</div>
<script>
(function(){var r=document.currentScript.previousElementSibling;if(!r||r.__cd)return;r.__cd=1;var d=r.dataset;
function z(n){return n<10?'0'+n:''+n}
function money(n){return '$'+Math.round(n).toString().replace(/\B(?=(\d{3})+(?!\d))/g,'.')}
function goal(){var now=new Date();if(d.mode==='date'&&d.date){var t=new Date(d.date.replace(' ','T'));if(!isNaN(t))return t}
var g=new Date(now.getFullYear(),now.getMonth(),now.getDate(),+d.h||0,+d.m||0,59,999);if(g<=now)g.setDate(g.getDate()+1);return g}
var g=goal(),el=r.querySelector('[data-sv3-cd-t]');
function tick(){var left=g-Date.now();if(left<=0){if(d.mode==='date'){if(d.hide==='true')r.closest('.shopify-section').hidden=true;left=0}else{g=goal();left=g-Date.now()}}
var t=Math.floor(left/1000),dd=Math.floor(t/86400);el.textContent=(dd?dd+'d ':'')+z(Math.floor(t%86400/3600))+':'+z(Math.floor(t%3600/60))+':'+z(t%60)}
function sync(){var p=[];try{p=JSON.parse(localStorage.getItem('sv3_picks_v1')||'[]')||[]}catch(e){}p=p.slice(0,3);var n=p.length,sum=0,min=1/0;
p.forEach(function(x){sum+=x.price||0;min=Math.min(min,x.price||0)});var pay=n===3?sum-min:sum;
r.style.setProperty('--sv3-cd-fill',n);[].forEach.call(r.querySelectorAll('.sv3-cd__bar i'),function(b,i){b.classList.toggle('on',i<n)});
r.querySelector('[data-sv3-cd-msg]').textContent=(d['m'+n]||'').replace('{n}',3-n);
var fs=+d.ship||0,sh=r.querySelector('[data-sv3-cd-ship]');if(!fs){sh.textContent='';return}
sh.classList.toggle('ok',pay>=fs&&n>0);sh.textContent=n===0?d.s0:(pay>=fs?d.s2:d.s1.replace('{monto}',money(fs-pay)))}
function setH(){document.documentElement.style.setProperty('--sv3-cd-h',(r.offsetHeight||0)+'px')}
tick();sync();setH();setInterval(function(){tick();setH()},1000);addEventListener('resize',setH);
new MutationObserver(sync).observe(r.querySelector('[data-sv3-progress]'),{childList:true,characterData:true,subtree:true});
document.addEventListener('visibilitychange',function(){if(!document.hidden){g=goal();tick();sync()}})})();
</script>
{% schema %}{"name":"3x2 · Barra fija","tag":"div","class":"sv3-section","settings":[{"type":"paragraph","content":"Barra que queda fija arriba al bajar: cuenta regresiva del 3x2, progreso de las 3 joyas elegidas y avance hacia el envío gratis."},{"type":"checkbox","id":"sticky","label":"Fija arriba al bajar","default":true},{"type":"text","id":"title","label":"Texto del reloj","default":"Últimas horas del 3x2"},{"type":"header","content":"Cuándo termina"},{"type":"select","id":"mode","label":"Tipo de cuenta","default":"daily","options":[{"value":"daily","label":"Se reinicia cada día a la hora indicada"},{"value":"date","label":"Termina en una fecha fija"}]},{"type":"range","id":"end_hour","label":"Hora de término (diario)","min":0,"max":23,"step":1,"default":23},{"type":"range","id":"end_minute","label":"Minuto de término (diario)","min":0,"max":59,"step":1,"default":59},{"type":"text","id":"end_date","label":"Fecha de término (fecha fija)","info":"Formato: 2026-11-30 23:59 (hora local)."},{"type":"checkbox","id":"hide_when_done","label":"Ocultar la barra cuando termine (fecha fija)","default":true},{"type":"header","content":"Mensajes según joyas elegidas"},{"type":"text","id":"msg_0","label":"Sin joyas","default":"Elige 3 joyas y una va por nuestra cuenta"},{"type":"text","id":"msg_1","label":"Con 1 joya","info":"{n} = joyas que faltan","default":"Agrega {n} más y una es gratis"},{"type":"text","id":"msg_2","label":"Con 2 joyas","default":"¡Solo 1 más y una es gratis!"},{"type":"text","id":"msg_3","label":"Con 3 joyas","default":"¡Listo! Una joya va por nuestra cuenta"},{"type":"header","content":"Envío gratis"},{"type":"number","id":"free_shipping","label":"Envío gratis desde ($)","info":"Solo el número, sin puntos. Vacío = no mostrar.","default":80000},{"type":"text","id":"ship_text","label":"Texto inicial","default":"Envío gratis sobre $80.000"},{"type":"text","id":"ship_missing","label":"Texto mientras falta","info":"{monto} = lo que falta","default":"Te faltan {monto} para envío gratis"},{"type":"text","id":"ship_ok","label":"Texto al alcanzarlo","default":"✓ Tienes envío gratis"},{"type":"header","content":"Colores"},{"type":"color","id":"bg","label":"Fondo","default":"#1a1714"},{"type":"color","id":"text","label":"Texto","default":"#f5f0e8"},{"type":"color","id":"accent","label":"Progreso y envío gratis","default":"#d9b779"},{"type":"color","id":"urgency","label":"Punto de urgencia (late)","info":"Vacío = el reloj de antes.","default":"#7f1d2d"},{"type":"color","id":"border","label":"Línea de abajo","info":"Útil con fondo blanco. Vacío = sin línea."}],"presets":[{"name":"3x2 · Barra fija"}]}{% endschema %}