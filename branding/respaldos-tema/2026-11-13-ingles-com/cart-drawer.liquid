  {{ product.variants | json }}
</textarea>
<div class="overlay-popup {{ product.handle }}">
  <span class="close-popup"style="width: 0px;
  font-size: 0px;
  line-height: 0px;
  opacity: 0;"><svg aria-hidden="true" focusable="false" role="presentation" class="icon icon-close" viewBox="0 0 64 64">
                <title>icon-X</title><path d="m19 17.61 27.12 27.13m0-27.12L19 44.74"></path>
              </svg></span>
  
  <div class="productcard">
    <div class="product-info">
      {%- comment -%} img_url y no image_url: image_url revienta con un producto
     SIN foto y escribe "invalid url input" en la pagina; img_url devuelve la
     imagen de relleno, que es lo que hacia el tema. {%- endcomment -%}
      <img src="{{ product.featured_image | img_url: '240x' }}" alt="{{ product.title }}" width="120" height="120" loading="lazy">
      <div class="product-text">
        <div class="product-title">{{ product.title }}</div>
        <div class="product-price">
          {{ product.selected_or_first_available_variant.price | money }}
          {% if product.selected_or_first_available_variant.compare_at_price > product.selected_or_first_available_variant.price %}
            <span class="product-compare">{{ product.selected_or_first_available_variant.compare_at_price | money }}</span>
          {% endif %}
        </div>
      </div>
    </div>

    <div class="variant-selector">
      {% for option in product.options_with_values %}
        <select name="options[{{ option.name }}]" class="variant-select" data-option-index="{{ forloop.index0 }}">
          {% for value in option.values %}
            <option value="{{ value | escape }}" {% if option.selected_value == value %}selected{% endif %}>
              {{ value }}
            </option>
          {% endfor %}
        </select>
      {% endfor %}
    </div>

<span class="customprobtn btn btn--full" id="customprobtn" data-product-id="{{ product.id }}">Agregar al carrito</span>
    <input type="hidden" name="id" class="product-variant-id" value="{{ product.selected_or_first_available_variant.id }}"> 



  </div>
</div>
{% endfor %}
{% endpaginate %}



                  
<script>
document.addEventListener('DOMContentLoaded', function() {
  document.querySelectorAll('.variant-select').forEach(select => {
    select.addEventListener('change', function() {
      const productCard = this.closest('.productcard');
      const variantJson = productCard.closest('.overlay-popup').previousElementSibling;
      const variants = JSON.parse(variantJson.value);
      const variantIdInput = productCard.querySelector('.product-variant-id');
      const priceElement = productCard.querySelector('.product-price');
      const comparePriceElement = productCard.querySelector('.product-compare');
      const addToCartBtn = productCard.querySelector('.customprobtn');

      // Get selected variant options 
      const  selectedOptions  =  [ ] ; 
      productCard . querySelectorAll ( '.variant-select' ) . forEach ( select  =>  { 
        selectedOptions . push ( select . value ) ; 
      } ) ; 

      // Match variant 
      const  matchedVariant  =  variants . find ( variant  => 
        variant . options . every ( ( option ,  index )  =>  option  ===  selectedOptions [ index ] ) 
      ) ; 

      if (matchedVariant) {
        // Inventory alert
        //alert(`Inventory: ${matchedVariant.inventory_quantity ?? matchedVariant.inventory ?? 'N/A'}`);

        // Availability
        const isAvailable = matchedVariant.available ?? matchedVariant.inventory_quantity > 0;
        //alert(isAvailable ? 'This variant is available.' : 'This variant is out of stock.');

        // Update button
        if (addToCartBtn) {
          if (isAvailable) {
            addToCartBtn.textContent = 'Agregar al carrito';
            addToCartBtn.classList.remove('sold-out');
          } else {
            addToCartBtn.textContent = 'Sold Out';
            addToCartBtn.classList.add('sold-out');
          }
        }

        // Update variant ID
        variantIdInput.value = matchedVariant.id;

        // Update price
        priceElement.innerHTML = (matchedVariant.price / 100).toLocaleString('en-US', {
          style: 'currency',
          currency: 'USD'
        });

        // Update compare price
        if (matchedVariant.compare_at_price > matchedVariant.price) {
          const comparePrice = (matchedVariant.compare_at_price / 100).toLocaleString('en-US', {
            style: 'currency',
            currency: 'USD'
          });
          if (!comparePriceElement) {
            priceElement.innerHTML += `<span class="product-compare">${comparePrice}</span>`;
          } else {
            comparePriceElement.textContent = comparePrice;
          }
        } else if (comparePriceElement) {
          comparePriceElement.remove();
        }
      }
    });
  });
});
</script>


 

