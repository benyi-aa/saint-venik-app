  /* Hide the native radio buttons */
.overlay-popup  input[type="radio"] {
  display: none;
}

/* Style labels as buttons */
.overlay-popup  label {
  display: inline-block;
  padding: 8px 16px;
  margin: 4px 8px 8px 0;
  border: 2px solid #ccc;
  border-radius: 4px;
  cursor: pointer;
  user-select: none;
  transition: background-color 0.3s, border-color 0.3s, color 0.3s;
}

/* Label hover effect */
.overlay-popup  label:hover {
  border-color: #007bff;
  color: #007bff;
}

/* Style label for the checked radio input */
.overlay-popup  input[type="radio"]:checked + label {
