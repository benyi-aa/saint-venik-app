

{% style %}
 {% if settings.icon-hidden %} 
.progress-bar::after {
  content: "✪";
  color: #FFF;
  position: absolute;
  right: -6px;
  z-index: 999;
  top: -9px;
  border: solid 1px;
  border-radius: 100%;
  padding: 0px;
  line-height: 20px;
  background: #FFC0CB;
  font-size: 25px;
}
  {% endif %}
.free-shipping-bar {
  width: 100%;
  max-width: 600px;
  text-align: center;
  margin: 4px 0px;
  text-align: center;
  background: #fff;
  z-index: 99;
  position: relative;
}

  .free-shipping-bar .shipping-message {
    font-size: {{ settings.font_size }}px;
    font-weight: 500;
    color: #333;
    margin-bottom: 0px;
  }

  .free-shipping-bar .shipping-message .amount {
    font-weight: 700;
    color: #000;
  }

  .free-shipping-bar .progress-container {
    width: 100%;
    height: 4px;
    background-color: {{ settings.bg_color }};
    border-radius: 3px;
  }

  .free-shipping-bar .progress-bar {
    height: 100%;
    background-color: {{ settings.progress_color }};
    transition: width {{ settings.transition_duration }}s ease;
    position: relative;
  }
{% endstyle %}

{%- assign threshold = settings.threshold | times: 100 -%}
{%- assign cart_total = cart.total_price -%}
{%- assign percentage = cart_total | times: 100 | divided_by: threshold | at_least: 0 | at_most: 100 -%}
{%- assign amount_remaining = threshold | minus: cart_total | money_without_trailing_zeros -%}




<div class="free-shipping-bar">
  <div class="shipping-message">

      <div class="beforemsg">
      {{ settings.success_message | default: "🎉 ¡Envío Gratis Desbloqueado!" }}
      </div>
<div class="aftermsg">
      {{ settings.message_prefix | default: "Estás a" }} 
      <span class="remaingamount">{{ amount_remaining }}</span> 
      {{ settings.message_suffix | default: "de desbloquear Envío Gratis!" }}
</div>
  </div>
  <div class="progress-container">
    <div class="progress-bar"></div>
  </div>
</div>
