{%- comment -%}
  Saint Venik · 3x2 en inglés (11-nov). Traduce un texto de las secciones sv3-* cuando la
  página se ve en /en/ (.com). Recibe t = el texto en español (el de la sección); si está en
  esta lista devuelve el inglés, si no lo deja igual. Si cambias un texto en español en el
  editor del tema, agrega aquí su inglés (la clave va sin saltos de línea).
  Detalle: docs/tema.md «3x2 en inglés».
{%- endcomment -%}
{% capture nl %}
{% endcapture -%}
{%- liquid
  assign o = t
  if request.locale.iso_code == 'en' and t != blank
    assign k = t | strip_newlines | strip
    case k
    when '4.87/5 · +50.000 clientes'
      assign o = '4.87/5 · 50,000+ customers'
    when 'Elige 3.Paga 2.'
      assign o = 'Pick 3.' | append: nl | append: 'Pay for 2.'
    when 'Una de las joyas va por nuestra cuenta.'
      assign o = 'One of the pieces is on us.'
    when 'Armar mi 3x2'
      assign o = 'Build my 3 for 2'
    when 'Oferta por tiempo limitado · Garantía Eterna'
      assign o = 'Limited-time offer · Lifetime Warranty'
    when 'Oro 18k'
      assign o = '18K Gold'
    when 'No se destiñe'
      assign o = "Won't tarnish"
    when 'Hipoalergénico'
      assign o = 'Hypoallergenic'
    when 'Garantía Eterna'
      assign o = 'Lifetime Warranty'
    when 'Últimas horas del 3x2'
      assign o = 'Final hours of the 3 for 2'
    when 'Elige 3 joyas y una va por nuestra cuenta'
      assign o = 'Pick 3 pieces and one is on us'
    when 'Agrega {n} más y una es gratis'
      assign o = 'Add {n} more and one is free'
    when '¡Solo 1 más y una es gratis!'
      assign o = 'Just 1 more and one is free!'
    when '¡Listo! Una joya va por nuestra cuenta'
      assign o = 'Done! One piece is on us'
    when 'Envío gratis sobre $80.000'
      assign o = 'Free shipping over $80'
    when 'Te faltan {monto} para envío gratis'
      assign o = "You're {monto} away from free shipping"
    when '✓ Tienes envío gratis'
      assign o = "✓ You've got free shipping"
    when 'Más de 50.000 hombres en todo Chile ya llevan Saint Venik'
      assign o = 'More than 50,000 men already wear Saint Venik'
    when 'Garantía Eterna · Apto para piel sensible'
      assign o = 'Lifetime Warranty · Safe for sensitive skin'
    when '3X2 en todo'
      assign o = '3 for 2 on everything'
    when 'Cada pieza incluye Garantía Eterna'
      assign o = 'Every piece includes a Lifetime Warranty'
    when '{n} joyas'
      assign o = '{n} pieces'
    when 'Ordenar'
      assign o = 'Sort'
    when 'Más vendidos'
      assign o = 'Best selling'
    when 'Precio: menor a mayor'
      assign o = 'Price: low to high'
    when 'Precio: mayor a menor'
      assign o = 'Price: high to low'
    when 'Añadir'
      assign o = 'Add'
    when 'En tu 3x2'
      assign o = 'In your 3 for 2'
    when 'Vista rápida'
      assign o = 'Quick view'
    when 'Medida'
      assign o = 'Size'
    when 'Oro'
      assign o = 'Gold'
    when 'Plateado'
      assign o = 'Silver'
    when 'Agotado'
      assign o = 'Sold out'
    when 'Ahorra {n}%'
      assign o = 'Save {n}%'
    when 'Añadir a mi 3x2'
      assign o = 'Add to my 3 for 2'
    when 'Descripción'
      assign o = 'Description'
    when 'Ver ficha completa'
      assign o = 'View full details'
    when 'Guía de tallas'
      assign o = 'Size guide'
    when 'No pudimos agregar las joyas. Intenta de nuevo.'
      assign o = "We couldn't add the pieces. Please try again."
    when 'No pudimos cargar esta colección. Intenta de nuevo.'
      assign o = "We couldn't load this collection. Please try again."
    when 'No hay joyas disponibles en esta colección.'
      assign o = 'No pieces available in this collection.'
    when 'Elige 3 joyas'
      assign o = 'Pick 3 pieces'
    when 'Escoge color y medida'
      assign o = 'Choose color and size'
    when 'Paga 2: una va por nuestra cuenta'
      assign o = 'Pay for 2: one is on us'
    when 'Cadenas'
      assign o = 'Chains'
    when 'Anillos'
      assign o = 'Rings'
    when 'Pulseras'
      assign o = 'Bracelets'
    when 'Colgantes'
      assign o = 'Pendants'
    when 'Conjuntos'
      assign o = 'Sets'
    when 'Total'
      assign o = 'Total'
    when 'Elige {n} más'
      assign o = 'Pick {n} more'
    when 'Ir a pagar'
      assign o = 'Checkout'
    when 'GRATIS'
      assign o = 'FREE'
    when '+50.000 clientes'
      assign o = '50,000+ customers'
    when 'Tienes envío gratis'
      assign o = "You've got free shipping"
    when 'Garantía Eterna incluida'
      assign o = 'Lifetime Warranty included'
    when 'Quitar'
      assign o = 'Remove'
    when 'Agregando…'
      assign o = 'Adding…'
    when 'Añadida ({n}/3)'
      assign o = 'Added ({n}/3)'
    when '¡Listo! Una de tus joyas va por nuestra cuenta.'
      assign o = 'Done! One of your pieces is on us.'
    when 'Ya elegiste tus 3. Quita una para cambiarla.'
      assign o = "You've already picked 3. Remove one to swap it."
    when 'Qué incluye tu 3x2'
      assign o = "What's included in your 3 for 2"
    when '3 joyas, pagas 2'
      assign o = '3 pieces, pay for 2'
    when 'Una de las tres va por nuestra cuenta.'
      assign o = 'One of the three is on us.'
    when 'Envío gratis'
      assign o = 'Free shipping'
    when 'Cada pieza, respaldada para siempre.'
      assign o = 'Every piece, backed forever.'
    when 'Apto para piel sensible'
      assign o = 'Safe for sensitive skin'
    when 'Hipoalergénico y no se destiñe.'
      assign o = "Hypoallergenic and won't tarnish."
    when 'Resistente al agua'
      assign o = 'Water resistant'
    when 'Al agua, al sudor y al calor.'
      assign o = 'Water, sweat and heat.'
    when 'Lo que dicen quienes ya lo llevan'
      assign o = 'What our customers say'
    when 'Compra verificada'
      assign o = 'Verified purchase'
    when 'Cadena Cuban Link Oro 8mm'
      assign o = 'Cuban Link Chain 8mm (Gold)'
    when 'Pulsera Black Clover Oro'
      assign o = 'Black Clover Bracelet (Gold)'
    when 'Desde que la uso, no he parado de tener cumplidos. Excelente calidad y versátil para todo momento.'
      assign o = "Ever since I started wearing it, I haven't stopped getting compliments. Excellent quality and versatile for any occasion."
    when 'Al principio me compré una y ya llevo como 6. Sabía que me volvería adicto a estas joyas. Lo que más me gusta es el brillo y las terminaciones. Además todas las joyas tanto los collares como las pulseras combinan muy bien entre sí pero sin llegar a verse exagerado.'
      assign o = "I bought one at first and now I'm on about 6. I knew I'd get hooked on these pieces. What I like most is the shine and the finish. Plus, all of them, necklaces and bracelets alike, pair really well together without ever looking over the top."
    when 'Así lo llevan'
      assign o = 'How they wear it'
    when '+50.000 clientes en todo Chile'
      assign o = '50,000+ happy customers'
    when 'Oferta por tiempo limitado'
      assign o = 'Limited-time offer'
    when 'Tres joyas.Una va por nuestra cuenta.'
      assign o = 'Three pieces.' | append: nl | append: 'One is on us.'
    when 'Eliges 3 joyas y la de menor valor va por nuestra cuenta. El descuento se aplica solo al pagar.'
      assign o = 'Pick 3 pieces and the lowest-priced one is on us. The discount applies automatically at checkout.'
    endcase
  endif
  echo o
-%}