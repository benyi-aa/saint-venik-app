            "code": "<script>\n(function(){\n  var p = window.location.pathname;\n  var isEN = (p === '/en' || p.indexOf('/en/') === 0);\n  document.documentElement.setAttribute('data-sv-locale', isEN ? 'en' : 'es');\n})();\n</script>\n\n<div class=\"sv-beneficios\" id=\"sv-beneficios\">\n  <div class=\"sv-beneficios__viewport\" id=\"sv-viewport\">\n    <div class=\"sv-beneficios__track\" id=\"sv-track\">\n\n      <div class=\"sv-beneficios__item\">\n        <div class=\"sv-beneficios__icono\">\n          <svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.5\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M7 17m-2 0a2 2 0 1 0 4 0a2 2 0 1 0 -4 0\"/><path d=\"M17 17m-2 0a2 2 0 1 0 4 0a2 2 0 1 0 -4 0\"/><path d=\"M5 17h-2v-11a1 1 0 0 1 1 -1h9v12m-4 0h6m4 0h2v-6h-8m0 -5h5l3 5\"/></svg>\n        </div>\n        <p class=\"sv-beneficios__titulo\">\n          <span class=\"sv-txt sv-txt--es\">ENVÍO GRATIS</span>\n          <span class=\"sv-txt sv-txt--en\">FREE SHIPPING</span>\n        </p>\n      </div>\n\n      <div class=\"sv-beneficios__item\">\n        <div class=\"sv-beneficios__icono\">\n          <svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.5\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M9 14l-4 -4l4 -4\"/><path d=\"M5 10h11a4 4 0 1 1 0 8h-1\"/></svg>\n        </div>\n        <p class=\"sv-beneficios__titulo\">\n          <span class=\"sv-txt sv-txt--es\">14 DÍAS DEVOLUCIÓN</span>\n          <span class=\"sv-txt sv-txt--en\">14-DAY RETURNS</span>\n        </p>\n      </div>\n\n      <div class=\"sv-beneficios__item\">\n        <div class=\"sv-beneficios__icono\">\n          <svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.5\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M12 17.75l-6.172 3.245l1.179 -6.873l-5 -4.867l6.9 -1.002l3.093 -6.253l3.093 6.253l6.9 1.002l-5 4.867l1.179 6.873z\"/></svg>\n        </div>\n        <p class=\"sv-beneficios__titulo\">\n          <span class=\"sv-txt sv-txt--es\">+3.000 RESEÑAS</span>\n          <span class=\"sv-txt sv-txt--en\">3,000+ REVIEWS</span>\n        </p>\n      </div>\n\n    </div>\n  </div>\n\n  <div class=\"sv-beneficios__dots\" id=\"sv-dots\" aria-hidden=\"true\">\n    <span class=\"sv-beneficios__dot\"><span class=\"sv-beneficios__fill\"></span></span>\n    <span class=\"sv-beneficios__dot\"><span class=\"sv-beneficios__fill\"></span></span>\n    <span class=\"sv-beneficios__dot\"><span class=\"sv-beneficios__fill\"></span></span>\n  </div>\n</div>\n\n<style>\n  #sv-beneficios {\n    --sv-fondo: #E7E6E6;\n    --sv-titulo: #111111;\n    --sv-icono: 26px;\n    --sv-duracion: 4s;\n    max-width: 100%;\n    margin: 0 auto;\n    background: var(--sv-fondo);\n  }\n\n  #sv-beneficios .sv-beneficios__viewport {\n    overflow: hidden;\n    background: var(--sv-fondo);\n  }\n\n  /* ---------- ESCRITORIO ---------- */\n  #sv-beneficios .sv-beneficios__track {\n    display: grid;\n    grid-template-columns: repeat(3, 1fr);\n    background: var(--sv-fondo);\n  }\n\n  #sv-beneficios .sv-beneficios__item {\n    padding: 22px 28px;\n    text-align: center;\n    display: flex;\n    flex-direction: column;\n    align-items: center;\n    gap: 10px;\n    box-sizing: border-box;\n    background: var(--sv-fondo);\n  }\n\n  #sv-beneficios .sv-beneficios__icono {\n    line-height: 0;\n    color: var(--sv-titulo);\n  }\n  #sv-beneficios .sv-beneficios__icono svg {\n    width: var(--sv-icono);\n    height: var(--sv-icono);\n  }\n\n  #sv-beneficios .sv-beneficios__titulo {\n    margin: 0;\n    font-size: 14px;\n    font-weight: 500;\n    letter-spacing: 0.04em;\n    text-transform: uppercase;\n    color: var(--sv-titulo);\n  }\n\n  #sv-beneficios .sv-beneficios__dots { display: none; }\n\n  /* ---------- MÓVIL: carrusel automático ---------- */\n  @media (max-width: 749px) {\n    #sv-beneficios .sv-beneficios__track {\n      grid-template-columns: none;\n      display: flex;\n      transition: transform 0.6s ease-in-out;\n      will-change: transform;\n    }\n    #sv-beneficios .sv-beneficios__item {\n      flex: 0 0 100%;\n      padding: 22px 24px;\n    }\n    #sv-beneficios .sv-beneficios__dots {\n      display: flex;\n      gap: 6px;\n      justify-content: center;\n      background: var(--sv-fondo);\n      padding: 0 0 14px;\n    }\n\n    #sv-beneficios .sv-beneficios__dot {\n      position: relative;\n      width: 24px;\n      height: 3px;\n      background: rgba(0,0,0,0.2);\n      overflow: hidden;\n      display: block;\n    }\n    #sv-beneficios .sv-beneficios__fill {\n      position: absolute;\n      top: 0;\n      left: 0;\n      height: 100%;\n      width: 0%;\n      background: var(--sv-titulo);\n    }\n    #sv-beneficios .sv-beneficios__dot.is-done .sv-beneficios__fill {\n      width: 100%;\n      transition: none;\n    }\n    #sv-beneficios .sv-beneficios__dot.is-idle .sv-beneficios__fill {\n      width: 0%;\n      transition: none;\n    }\n    #sv-beneficios .sv-beneficios__dot.is-active .sv-beneficios__fill {\n      width: 100%;\n      transition: width var(--sv-duracion) linear;\n    }\n  }\n\n  /* --- Interruptor de idioma (SIEMPRE AL FINAL) --- */\n  #sv-beneficios .sv-txt--en { display: none !important; }\n  #sv-beneficios .sv-txt--es { display: inline !important; }\n  html[data-sv-locale=\"en\"] #sv-beneficios .sv-txt--es { display: none !important; }\n  html[data-sv-locale=\"en\"] #sv-beneficios .sv-txt--en { display: inline !important; }\n</style>\n\n<script>\n  (function () {\n    var root = document.getElementById('sv-beneficios');\n    if (!root) return;\n    var track = document.getElementById('sv-track');\n    var dots  = document.querySelectorAll('#sv-dots .sv-beneficios__dot');\n    var total = track.children.length;\n    var DURACION = 4000;\n    var index = 0;\n    var timer = null;\n\n    function esMovil() {\n      return window.matchMedia('(max-width: 749px)').matches;\n    }\n\n    function pintarBarras(activo) {\n      for (var d = 0; d < dots.length; d++) {\n        dots[d].classList.remove('is-active', 'is-done', 'is-idle');\n        if (d < activo) {\n          dots[d].classList.add('is-done');\n        } else if (d === activo) {\n          dots[d].classList.add('is-idle');\n        } else {\n          dots[d].classList.add('is-idle');\n        }\n      }\n      void dots[activo].offsetWidth;\n      dots[activo].classList.remove('is-idle');\n      dots[activo].classList.add('is-active');\n    }\n\n    function mostrar(i) {\n      track.style.transform = 'translateX(-' + (i * 100) + '%)';\n      pintarBarras(i);\n    }\n\n    function iniciar() {\n      detener();\n      if (!esMovil() || total < 2) {\n        track.style.transform = '';\n        return;\n      }\n      index = 0;\n      mostrar(0);\n      timer = setInterval(function () {\n        index = (index + 1) % total;\n        mostrar(index);\n      }, DURACION);\n    }\n\n    function detener() {\n      if (timer) {\n        clearInterval(timer);\n        timer = null;\n      }\n    }\n\n    iniciar();\n    window.addEventListener('resize', iniciar);\n  })();\n</script>",
