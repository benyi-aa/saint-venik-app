        "custom_bTbTQH": {
          "type": "custom",
          "settings": {
            "code": "<script>\n(function(){\n  var p = window.location.pathname;\n  var isEN = (p === '/en' || p.indexOf('/en/') === 0);\n  document.documentElement.setAttribute('data-sv-locale', isEN ? 'en' : 'es');\n})();\n</script>\n\n<!-- META DE PRODUCTO: Reseñas + Estado de stock -->\n<div class=\"prod-meta\">\n  <!-- Izquierda: estrellas + texto -->\n  <div class=\"pm-left\">\n    <span class=\"pm-stars\" aria-hidden=\"true\">\n      <svg viewBox=\"0 0 20 20\" class=\"star\"><path d=\"M10 1.6l2.3 4.7 5.2.8-3.8 3.7.9 5.2L10 13.9 5.4 16l.9-5.2L2.4 7.1l5.2-.8L10 1.6z\"/></svg>\n      <svg viewBox=\"0 0 20 20\" class=\"star\"><path d=\"M10 1.6l2.3 4.7 5.2.8-3.8 3.7.9 5.2L10 13.9 5.4 16l.9-5.2L2.4 7.1l5.2-.8L10 1.6z\"/></svg>\n      <svg viewBox=\"0 0 20 20\" class=\"star\"><path d=\"M10 1.6l2.3 4.7 5.2.8-3.8 3.7.9 5.2L10 13.9 5.4 16l.9-5.2L2.4 7.1l5.2-.8L10 1.6z\"/></svg>\n      <svg viewBox=\"0 0 20 20\" class=\"star\"><path d=\"M10 1.6l2.3 4.7 5.2.8-3.8 3.7.9 5.2L10 13.9 5.4 16l.9-5.2L2.4 7.1l5.2-.8L10 1.6z\"/></svg>\n      <svg viewBox=\"0 0 20 20\" class=\"star\"><path d=\"M10 1.6l2.3 4.7 5.2.8-3.8 3.7.9 5.2L10 13.9 5.4 16l.9-5.2L2.4 7.1l5.2-.8L10 1.6z\"/></svg>\n    </span>\n    <span class=\"pm-text\">\n      <span class=\"sv-txt sv-txt--es\">+50.000 Clientes</span>\n      <span class=\"sv-txt sv-txt--en\">50,000+ Customers</span>\n    </span>\n  </div>\n  <!-- Derecha: punto radar + texto -->\n  <div class=\"pm-right\" role=\"status\" aria-live=\"polite\">\n    <span class=\"pm-dot\" aria-hidden=\"true\"></span>\n    <span class=\"pm-status\">\n      <span class=\"sv-txt sv-txt--es\">Listo para enviar</span>\n      <span class=\"sv-txt sv-txt--en\">Ready to ship</span>\n    </span>\n  </div>\n</div>\n\n<style>\n\n.prod-meta{\n  --pm-star:#000000;\n  --pm-text:#374151;\n  --pm-green:#16A349;\n  display:flex; align-items:center; justify-content:space-between;\n  gap:12px;\n  font-family:-apple-system,BlinkMacSystemFont,\"Segoe UI\",Roboto,Arial,sans-serif;\n  font-weight:600; font-size:12px; line-height:1.2;\n  color:#111827;\n  margin:6px 0 2px;\n}\n\n.pm-left{display:flex; align-items:center; gap:6px; color:var(--pm-text);}\n.pm-stars{display:inline-flex; gap:3px;}\n.pm-stars .star{width:12px; height:12px; fill:var(--pm-star); display:block;}\n.pm-text{font-size:11px; white-space:nowrap;}\n\n.pm-right{display:flex; align-items:center; gap:6px; color:var(--pm-green);}\n.pm-status{white-space:nowrap;}\n\n.pm-dot{\n  position:relative; width:8px; height:8px; border-radius:999px;\n  background:currentColor; flex:0 0 8px;\n  box-shadow:0 0 0 5px rgba(22,163,73,.10);\n}\n.pm-dot::before,\n.pm-dot::after{\n  content:\"\"; position:absolute; inset:0; border-radius:999px;\n  border:1px solid currentColor; opacity:.6; transform:scale(1);\n  animation:pm-ripple 3.6s ease-out infinite;\n}\n.pm-dot::after{ animation-delay:1.8s; opacity:.5; }\n@keyframes pm-ripple{\n  0%   { transform:scale(1);   opacity:.6; }\n  65%  { transform:scale(2.2); opacity:.12; }\n  100% { transform:scale(2.4); opacity:0; }\n}\n@media (min-width:768px){\n  .prod-meta{ font-size:13px; }\n  .pm-stars .star{ width:13px; height:13px; }\n  .pm-text{ font-size:12px; }\n}\n\n\n.prod-meta .sv-txt--en { display: none !important; }\n.prod-meta .sv-txt--es { display: inline !important; }\nhtml[data-sv-locale=\"en\"] .prod-meta .sv-txt--es { display: none !important; }\nhtml[data-sv-locale=\"en\"] .prod-meta .sv-txt--en { display: inline !important; }\n</style>"
