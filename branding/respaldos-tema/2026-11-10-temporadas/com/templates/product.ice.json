            "code": "<script>\n(function(){\n  var p = window.location.pathname;\n  var isEN = (p === '/en' || p.indexOf('/en/') === 0);\n  document.documentElement.setAttribute('data-sv-locale', isEN ? 'en' : 'es');\n})();\n</script>\n\n<!-- Testimonio SOLO móvil -->\n<div class=\"sv-testi\">\n  <div class=\"sv-testi__card\">\n\n    <div class=\"sv-testi__head\">\n      <img src=\"https://cdn.shopify.com/s/files/1/0708/1626/8540/files/f9e12fedbe806dfde4674f6d8e664272.jpg?v=1728657303\"\n           alt=\"\"\n           class=\"sv-testi__avatar\">\n      <div class=\"sv-testi__meta\">\n        <div class=\"sv-testi__stars\">★★★★★</div>\n        <div class=\"sv-testi__name\">Jorge R.</div>\n      </div>\n    </div>\n\n    <p class=\"sv-testi__quote\">\n      <span class=\"sv-txt sv-txt--es\">“Estas cadenas son excelentes realmente. Las compré en la noche y me llegaron al otro día!! he usado durante meses las que me compré y todavía están como nuevas. Calidad increíble. Las he puesto a prueba en el gimnasio, en la ducha y tirones ocasionales... siguen impecables como el primer día!”</span>\n      <span class=\"sv-txt sv-txt--en\">“These chains are seriously great. I ordered at night and they showed up the next day!! I've been wearing mine for months and they still look brand new. Incredible quality. I've put them through the gym, the shower, the occasional yank... still flawless, just like day one!”</span>\n    </p>\n\n    <div class=\"sv-testi__verified\">\n      <span class=\"sv-testi__check\">✔️</span>\n      <span class=\"sv-txt sv-txt--es\">COMPRA VERIFICADA</span>\n      <span class=\"sv-txt sv-txt--en\">VERIFIED PURCHASE</span>\n    </div>\n\n  </div>\n</div>\n\n<style>\n  \n  .sv-testi {\n    display: none;\n  }\n  \n  @media (max-width: 768px) {\n    .sv-testi {\n      display: block;\n      margin: 16px auto;\n    }\n  }\n\n  .sv-testi__card {\n    background: #f9f9f9;\n    padding: 20px;\n    border-radius: 10px;\n    max-width: 500px;\n    font-family: sans-serif;\n    color: #1a1a1a;\n    box-shadow: 0 2px 6px rgba(0,0,0,0.05);\n    box-sizing: border-box;\n  }\n  .sv-testi__head {\n    display: flex;\n    align-items: center;\n    margin-bottom: 15px;\n  }\n\n  \n  .sv-testi .sv-testi__avatar {\n    width: 50px !important;\n    height: 50px !important;\n    min-width: 50px;\n    min-height: 50px;\n    max-width: 50px;\n    max-height: 50px;\n    border-radius: 50%;\n    object-fit: cover;\n    object-position: center;\n    margin-right: 12px;\n    display: block;\n    align-self: center;\n  }\n\n  .sv-testi__meta {\n    min-width: 0;\n  }\n  .sv-testi__stars {\n    color: #000;\n    font-size: 18px;\n    font-weight: 600;\n    line-height: 1.2;\n  }\n  .sv-testi__name {\n    font-weight: bold;\n    font-size: 16px;\n  }\n  .sv-testi__quote {\n    font-size: 15px;\n    line-height: 1.6;\n    margin: 0 0 20px;\n  }\n  .sv-testi__verified {\n    font-size: 13px;\n    color: #888888;\n    display: flex;\n    align-items: center;\n    gap: 5px;\n  }\n  .sv-testi__check {\n    font-size: 16px;\n  }\n\n  \n  .sv-testi .sv-txt--en { display: none !important; }\n  .sv-testi .sv-txt--es { display: inline !important; }\n  html[data-sv-locale=\"en\"] .sv-testi .sv-txt--es { display: none !important; }\n  html[data-sv-locale=\"en\"] .sv-testi .sv-txt--en { display: inline !important; }\n</style>",
