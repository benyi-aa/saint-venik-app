efit-item {\n  display: flex;\n  align-items: flex-start;\n  gap: 12px;\n  background: #f9f9f9;\n  border-radius: 8px;\n  padding: 12px 16px;\n  box-shadow: 0 2px 6px rgba(0, 0, 0, 0.06);\n}\n.benefit-list-{{ section.id }} .benefit-item img {\n  width: 36px;\n  height: 36px;\n  flex: 0 0 36px;\n}\n.benefit-list-{{ section.id }} .benefit-text {\n  text-align: left;\n}\n.benefit-list-{{ section.id }} .benefit-text strong {\n  display: block;\n  font-size: 14px;\n  font-weight: bold;\n  margin-bottom: 2px;\n}\n.benefit-list-{{ section.id }} .benefit-text p {\n  margin: 0;\n  font-size: 13px;\n  line-height: 1.4;\n}\n</style>"
