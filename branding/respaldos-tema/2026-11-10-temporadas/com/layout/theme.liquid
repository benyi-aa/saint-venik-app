<script>
  (function () {
    var ID = 'CHW8yG48rc4';
    var ATTRS = ['src', 'href', 'data-src', 'data-id', 'data-video-id', 'data-youtube-id', 'style'];

    function matches(el) {
      if (!el.getAttribute) return false;
      for (var i = 0; i < ATTRS.length; i++) {
        var v = el.getAttribute(ATTRS[i]);
        if (v && v.indexOf(ID) !== -1) return true;
      }
      return false;
    }

    function hide(el) {
      el.style.setProperty('display', 'none', 'important');
      if (el.tagName === 'IFRAME' || el.tagName === 'IMG') el.removeAttribute('src');
      var p = el;
      for (var i = 0; i < 4 && p.parentElement; i++) {
        p = p.parentElement;
        if (p.children.length === 1) p.style.setProperty('display', 'none', 'important');
        else break;
      }
    }

    function scan(root) {
      if (!root.querySelectorAll) return;
      Array.prototype.forEach.call(root.querySelectorAll('*'), function (el) {
        if (matches(el)) hide(el);
      });
    }

    scan(document);
    new MutationObserver(function (records) {
      records.forEach(function (r) {
        r.addedNodes.forEach(function (n) {
          if (n.nodeType !== 1) return;
          if (matches(n)) hide(n);
          scan(n);
        });
      });
    }).observe(document.documentElement, { childList: true, subtree: true });
  })();
</script>
