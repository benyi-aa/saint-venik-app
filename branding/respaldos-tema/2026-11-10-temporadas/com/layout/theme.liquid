  <script>
    document.addEventListener('click', function(event) {
      var modal = document.querySelector('.ms-quick-view-modal-view');
      if (modal) {
        if (!modal.contains(event.target) || event.target.closest('button.add-to-cart')) {
          modal.classList.remove('ms-quick-view-modal-view');
        }
      }
    });
    document.querySelector('.ms-quick-view-overlay').addEventListener('click', function() {
      var abierto = document.querySelector('.ms-quick-view-modal-open');
      if (abierto) { abierto.classList.remove("ms-quick-view-modal-open"); }
      document.querySelector('body').classList.remove("ms-quick-view-modal-view2");
    });
    document.addEventListener('click', function(event) {
      const button = event.target.closest('.ms-quick-view-btn-add');
      if (button) {
        const btnSectionID = button.dataset.id;
        const productGrid = button.closest('.grid-product');
        const msQuickView = productGrid.querySelector('.ms-quick-view-modal');
        if (window.innerWidth <= 700) {
          if (msQuickView) {
            if (!msQuickView.classList.contains('ms-quick-view-modal-init')) {
              document.body.insertBefore(msQuickView, document.body.firstChild);
              msQuickView.classList.add("ms-quick-view-modal-init");
              var sectionID = msQuickView.dataset.sectionId;
              var sectionType = msQuickView.dataset.sectionType;
              theme.sections.register(sectionType, theme.MSQuickViewModal);
            }
            document.getElementById(btnSectionID).classList.add("ms-quick-view-modal-open");
            setTimeout(function() {
              document.querySelector('body').classList.add("ms-quick-view-modal-view2");
            }, 200);
          } else if (document.getElementById(btnSectionID)) {
            document.getElementById(btnSectionID).classList.add("ms-quick-view-modal-open");
            setTimeout(function() {
              document.querySelector('body').classList.add("ms-quick-view-modal-view2");
            }, 200);
          }
        } else {
          if (msQuickView) {
            if (!productGrid.classList.contains('ms-quick-view-modal-init')) {
              productGrid.classList.add("ms-quick-view-modal-init");
              var sectionID = msQuickView.dataset.sectionId;
              var sectionType = msQuickView.dataset.sectionType;
              theme.sections.register(sectionType, theme.MSQuickViewModal);
            }
            productGrid.classList.add("ms-quick-view-modal-view");
          }
        }
      }
    });
  </script>
<script>
  document.addEventListener("DOMContentLoaded", function () {
    document.body.addEventListener("click", function (event) {

      const closeBtn = event.target.closest(".closebtn");

      if (closeBtn) {
        const prohandleClass = closeBtn.getAttribute("prohandle");

        if (!prohandleClass) return;

        // Find the modal using the class from prohandle attribute
        const modal = document.querySelector(`.${prohandleClass}`);

        if (modal) {
          modal.classList.add("custom-refresh-class");
          modal.classList.remove("activemodel");
        } else {
          console.warn(`No element found with class: ${prohandleClass}`);
        }
      }
    });
  });
</script>

<script>
  document.addEventListener("DOMContentLoaded", function () {
    document.body.addEventListener("click", function (event) {
      const clickedBtn = event.target.closest(".ms-quick-view-btn-add");

      if (clickedBtn) {
        const prohandleClass = clickedBtn.getAttribute("prohandle");
        if (!prohandleClass) return;

      

        // Use prohandleClass as the selector to find the target element
        const modals = document.querySelector(`.${prohandleClass}`);

        if (modals) {

          setTimeout(function () {
            modals.classList.add("activemodel");
          }, 500);
        } else {
          console.warn(`No element found with class: ${prohandleClass}`);
        }
      }
    });
  });
</script>
<script>
  document.addEventListener("DOMContentLoaded", function () {
    document.body.addEventListener("click", function (event) {
      const addToCartBtn = event.target.closest(".add-to-cart");

      if (addToCartBtn) {
        // Delay before triggering .closebtn
        setTimeout(function () {
          const closeBtn = document.querySelector(".closebtn");
          if (closeBtn) {
            closeBtn.click(); // Simulate the click after delay
          }
        }, 500); // Delay in milliseconds (500ms = 0.5s)
      }
    });
  });
</script>





