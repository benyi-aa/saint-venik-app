<script>
  (function () {
    var WORDS = {
      'dorado': 'Gold',
      'plateado': 'Silver',
      'guía de tallas': 'Size Chart'
    };
    var FIND = /\b(dorado|plateado|gu[ií]a\s+de\s+tallas)\b/gi;
    var SKIP = { SCRIPT: 1, STYLE: 1, NOSCRIPT: 1, TEXTAREA: 1 };
    var watched = new WeakSet();

    function swap(match) {
      var key = match.toLowerCase().replace(/\s+/g, ' ').replace('guia', 'guía');
      var en = WORDS[key];
      if (!en) return match;
      return match === match.toUpperCase() ? en.toUpperCase() : en;
    }

    function fixText(node) {
      var parent = node.parentNode;
      if (!node.nodeValue || (parent && SKIP[parent.nodeName])) return;
      var updated = node.nodeValue.replace(FIND, swap);
      if (updated !== node.nodeValue) node.nodeValue = updated;
    }

    function scan(root) {
      if (root.nodeType === 3) return fixText(root);
      if (root.nodeType !== 1 && root.nodeType !== 11) return;
      if (SKIP[root.nodeName]) return;
      var walker = document.createTreeWalker(root, NodeFilter.SHOW_TEXT);
      var node;
      while ((node = walker.nextNode())) fixText(node);
    }

    function watch(root) {
      if (watched.has(root)) return;
      watched.add(root);
      scan(root);
      new MutationObserver(function (records) {
        records.forEach(function (r) {
          if (r.type === 'characterData') fixText(r.target);
          else r.addedNodes.forEach(scan);
        });
      }).observe(root, { childList: true, characterData: true, subtree: true });
    }

    function watchShadowRoots() {
      document.querySelectorAll('*').forEach(function (el) {
        if (el.shadowRoot) watch(el.shadowRoot);
      });
    }

    watch(document.body);
    watchShadowRoots();
    setInterval(watchShadowRoots, 1500);
  })();
</script>
{% endif %}
