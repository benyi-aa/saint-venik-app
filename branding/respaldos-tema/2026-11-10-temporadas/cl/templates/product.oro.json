        "custom_BHrnjB": {
          "type": "custom",
          "settings": {
            "code": "{%- if request.page_type == 'product' and product != blank -%}\n\n{%- liquid\n  assign img_garantia = 'https://cdn.shopify.com/s/files/1/0773/8218/9103/files/2_38dba500-5f63-4cc6-a700-a493085e724e.png?v=1786944810'\n  assign img_estuche  = 'https://cdn.shopify.com/s/files/1/0773/8218/9103/files/3_036952f7-79e7-4c83-8d5d-6e63d82ef2cb.png?v=1786944811'\n\n  assign tipo = product.type | downcase | strip\n  assign titulo = product.title | downcase\n  assign etiquetas = product.tags | join: ' ' | downcase\n  assign texto = tipo | append: ' ' | append: titulo | append: ' ' | append: etiquetas\n\n  assign categoria = 'Pieza'\n  if texto contains 'pulsera' or texto contains 'bracelet'\n    assign categoria = 'Pulsera'\n  elsif texto contains 'colgante' or texto contains 'pendant' or texto contains 'dije'\n    assign categoria = 'Colgante'\n  elsif texto contains 'anillo'\n    assign categoria = 'Anillo'\n  elsif texto contains 'cadena' or texto contains 'collar' or texto contains 'chain'\n    assign categoria = 'Cadena'\n  endif\n\n  assign v = product.selected_or_first_available_variant\n-%}\n\n<div class=\"cro-wi\" id=\"cro-wi-{{ product.id }}\" data-cro-wi-root>\n  <p class=\"cro-wi__heading\">Qué incluye</p>\n  <div class=\"cro-wi__tiles\">\n\n    <div class=\"cro-wi__tile\">\n      <span class=\"cro-wi__label\">{{ categoria }}</span>\n      <span class=\"cro-wi__media\">\n        <img src=\"{{ v.image | default: product.featured_image | image_url: width: 400 }}\" alt=\"{{ product.title | escape }}\" width=\"400\" height=\"400\" loading=\"lazy\" data-cro-wi-img>\n      </span>\n      <span class=\"cro-wi__price\" data-cro-wi-price>{{ v.price | money }}</span>\n    </div>\n\n    <div class=\"cro-wi__tile\">\n      <span class=\"cro-wi__label\">Garantía Eterna</span>\n      <span class=\"cro-wi__media\">\n        <img src=\"{{ img_garantia }}\" alt=\"Garantía Eterna\" width=\"400\" height=\"400\" loading=\"lazy\">\n      </span>\n      <span class=\"cro-wi__price cro-wi__price--free\">GRATIS <s data-cro-wi-val=\"garantia\">$20</s></span>\n    </div>\n\n    <div class=\"cro-wi__tile\">\n      <span class=\"cro-wi__label\">Packaging</span>\n      <span class=\"cro-wi__media\">\n        <img src=\"{{ img_estuche }}\" alt=\"Packaging\" width=\"400\" height=\"400\" loading=\"lazy\">\n      </span>\n      <span class=\"cro-wi__price cro-wi__price--free\">GRATIS <s data-cro-wi-val=\"estuche\">$4</s></span>\n    </div>\n\n  </div>\n\n  <p class=\"cro-wi__unlocked\">\n    Incluye <strong data-cro-wi-val=\"total\">$24</strong> en extras <strong>sin costo</strong>\n  </p>\n\n  <script type=\"application/json\" data-cro-wi-data>\n    {\n      {%- for variante in product.variants -%}\n        \"{{ variante.id }}\": {\n          \"precio\": {{ variante.price | money | json }},\n          \"img\": {{ variante.image | default: product.featured_image | image_url: width: 400 | json }}\n        }{%- unless forloop.last -%},{%- endunless -%}\n      {%- endfor -%}\n    }\n  </script>\n</div>\n\n<style>\n  #cro-wi-{{ product.id }} {\n    border: 1px solid #E3E3E3;\n    border-radius: 12px;\n    padding: 12px 12px 10px;\n    margin: 0 0 14px;\n    background: #FFFFFF;\n    box-sizing: border-box;\n    text-align: left;\n    contain: layout style;\n  }\n  #cro-wi-{{ product.id }} * {\n    box-sizing: border-box;\n  }\n  #cro-wi-{{ product.id }} .cro-wi__heading {\n    margin: 0 0 9px;\n    font-size: 13px;\n    font-weight: 700;\n    letter-spacing: 0.06em;\n    text-transform: uppercase;\n    color: #111111;\n    line-height: 1.2;\n    text-align: left;\n  }\n  #cro-wi-{{ product.id }} .cro-wi__tiles {\n    display: grid;\n    grid-template-columns: repeat(3, 1fr);\n    gap: 8px;\n  }\n  #cro-wi-{{ product.id }} .cro-wi__tile {\n    border: 1px solid #E3E3E3;\n    border-radius: 10px;\n    padding: 9px 4px 8px;\n    display: flex;\n    flex-direction: column;\n    align-items: center;\n    text-align: center;\n    gap: 6px;\n    background: #FFFFFF;\n    min-width: 0;\n  }\n  #cro-wi-{{ product.id }} .cro-wi__label {\n    display: block;\n    width: 100%;\n    font-size: clamp(9px, 2.75vw, 13px);\n    font-weight: 700;\n    color: #111111;\n    line-height: 1.2;\n    white-space: nowrap;\n    overflow: hidden;\n    text-overflow: ellipsis;\n  }\n  #cro-wi-{{ product.id }} .cro-wi__media {\n    display: block;\n    width: 100%;\n    aspect-ratio: 1 / 1;\n    background: transparent;\n    border-radius: 6px;\n    overflow: hidden;\n  }\n  #cro-wi-{{ product.id }} .cro-wi__media img {\n    width: 100%;\n    height: 100%;\n    object-fit: contain;\n    display: block;\n  }\n  #cro-wi-{{ product.id }} .cro-wi__price {\n    display: flex;\n    align-items: baseline;\n    justify-content: center;\n    gap: 4px;\n    white-space: nowrap;\n    font-size: clamp(9.5px, 2.9vw, 15px);\n    font-weight: 700;\n    color: #111111;\n    line-height: 1.2;\n  }\n  #cro-wi-{{ product.id }} .cro-wi__price--free {\n    color: #0A7C3E;\n    text-transform: uppercase;\n  }\n  #cro-wi-{{ product.id }} .cro-wi__price--free s {\n    color: #9A9A9A;\n    font-weight: 700;\n    text-decoration: line-through;\n  }\n  #cro-wi-{{ product.id }} .cro-wi__unlocked {\n    margin: 9px 0 0;\n    text-align: center;\n    font-size: clamp(11px, 3vw, 14px);\n    color: #333333;\n    line-height: 1.3;\n  }\n  #cro-wi-{{ product.id }} .cro-wi__unlocked strong {\n    color: #111111;\n    font-weight: 700;\n  }\n</style>\n\n<script>\n(function () {\n  var raiz = document.getElementById('cro-wi-{{ product.id }}');\n  if (!raiz || raiz.dataset.croWiInit) return;\n  raiz.dataset.croWiInit = '1';\n\n  /* Solo opera en la ficha de producto */\n  if (!document.body.classList.contains('template-product') &&\n      !document.querySelector('form[action*=\"/cart/add\"] [name=\"id\"]')) {\n    return;\n  }\n\n  /* =========================================================\n     TABLA DE VALORES POR MONEDA\n     Editar aquí los montos de cada mercado.\n     ========================================================= */\n  var VALORES = {\n    USD: { garantia: '$20',      estuche: '$4',      total: '$24'      },\n    EUR: { garantia: '€17',      estuche: '€4',      total: '€21'      },\n    CLP: { garantia: '$20.000',  estuche: '$3.490',  total: '$23.490'  },\n    MXN: { garantia: '$349',     estuche: '$69',     total: '$418'     }\n  };\n  var POR_DEFECTO = 'USD';\n\n  function monedaActiva() {\n    if (window.Shopify && Shopify.currency && Shopify.currency.active) {\n      return Shopify.currency.active;\n    }\n    return POR_DEFECTO;\n  }\n\n  function pintarValores() {\n    var cod = monedaActiva();\n    var tabla = VALORES[cod] || VALORES[POR_DEFECTO];\n    var nodos = raiz.querySelectorAll('[data-cro-wi-val]');\n    for (var i = 0; i < nodos.length; i++) {\n      var clave = nodos[i].getAttribute('data-cro-wi-val');\n      if (tabla[clave]) nodos[i].textContent = tabla[clave];\n    }\n  }\n\n  pintarValores();\n\n  /* ---------- Precio e imagen de la primera tarjeta ---------- */\n  var datos = {};\n  try {\n    datos = JSON.parse(raiz.querySelector('[data-cro-wi-data]').textContent);\n  } catch (e) { return; }\n\n  var elPrecio = raiz.querySelector('[data-cro-wi-price]');\n  var elImg = raiz.querySelector('[data-cro-wi-img]');\n  var ultimoId = null;\n\n  function aplicar(id) {\n    if (!id || String(id) === String(ultimoId)) return;\n    var d = datos[String(id)];\n    if (!d) return;\n    ultimoId = id;\n    if (elPrecio && d.precio) elPrecio.innerHTML = d.precio;\n    if (elImg && d.img) elImg.src = d.img;\n  }\n\n  /* Contenedor de la ficha: nunca cae a document */\n  var seccion =\n    raiz.closest('[id^=\"ProductSection-\"]') ||\n    raiz.closest('.product-single') ||\n    raiz.closest('form[action*=\"/cart/add\"]') ||\n    raiz.parentElement;\n\n  if (seccion) {\n    seccion.addEventListener('variantChange', function (e) {\n      if (e.detail && e.detail.variant) aplicar(e.detail.variant.id);\n    });\n  }\n\n  /* Lee la variante únicamente del formulario de compra principal */\n  function leerActual() {\n    var desdeUrl = new URL(window.location.href).searchParams.get('variant');\n    if (desdeUrl && /^\\d+$/.test(desdeUrl)) return desdeUrl;\n\n    var campo =\n      document.querySelector('form[action*=\"/cart/add\"] select[name=\"id\"]') ||\n      document.querySelector('form[action*=\"/cart/add\"] input[name=\"id\"]');\n\n    if (campo && campo.value && /^\\d+$/.test(String(campo.value).trim())) {\n      return campo.value;\n    }\n    return null;\n  }\n\n  /* Se detiene solo si el bloque desaparece del DOM */\n  var reloj = setInterval(function () {\n    if (!document.body.contains(raiz)) {\n      clearInterval(reloj);\n      return;\n    }\n    aplicar(leerActual());\n  }, 500);\n\n  window.addEventListener('popstate', function () { aplicar(leerActual()); });\n})();\n</script>\n\n{%- endif -%}"
          }
