          "type": "custom",
          "disabled": true,
          "settings": {
            "code": "<!DOCTYPE html>\n<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n    <meta charset=\"UTF-8\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n    <title>Full Width Image with Enhanced Shadow</title>\n    <style>\n        /* Contenedor para la imagen */\n        .full-width-image-container {\n            width: 100%; /* Asegura que ocupe todo el ancho */\n            margin: 0; /* Elimina márgenes */\n            padding: 20px 0 0 0; /* Agrega padding superior de 20px */\n        }\n\n        /* Imagen que ocupa todo el ancho con sombra */\n        .full-width-image {\n            width: 100%; /* Asegura que la imagen ocupe todo el ancho */\n            height: auto; /* Mantiene la proporción */\n            display: block; /* Elimina espacios blancos adicionales */\n            border-radius: 8px; /* Opcional: esquinas redondeadas */\n            box-shadow: 0 8px 20px rgba(0, 0, 0, 0.3); /* Sombra más pronunciada */\n            transition: transform 0.3s ease, box-shadow 0.3s ease; /* Transición suave */\n        }\n\n        /* Efecto al pasar el mouse sobre la imagen */\n        .full-width-image:hover {\n            transform: translateY(-7px); /* Efecto de elevación */\n            box-shadow: 0 12px 30px rgba(0, 0, 0, 0.4); /* Sombra aún más pronunciada */\n        }\n    </style>\n</head>\n<body>\n    <!-- Contenedor de la imagen -->\n    <div class=\"full-width-image-container\">\n        <img src=\"https://cdn.shopify.com/s/files/1/0717/3006/9807/files/review.png?v=1742092894\" alt=\"Full Width Image with Enhanced Shadow\" class=\"full-width-image\">\n    </div>\n</body>\n</html>"
