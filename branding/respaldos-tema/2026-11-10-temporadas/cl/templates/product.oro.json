          "disabled": true,
          "settings": {
            "code": "<div class=\"banner-3x2-{{ section.id }}\">\n  <p><strong>3X2 EN TODAS LAS JOYAS</strong></p>\n  <p>Añade 3 al carrito y una es gratis</p>\n</div>\n<style>\n  .banner-3x2-{{ section.id }} {\n    background-color: #e5d9cc;\n    border-radius: 0px;\n    padding: 8px 20px;\n    text-align: center;\n    font-family: 'Helvetica Neue', Arial, sans-serif;\n    max-width: 800px;\n    margin: 0 auto;\n  }\n  .banner-3x2-{{ section.id }} p {\n    color: #1a1a1a;\n    font-size: 15px;\n    font-weight: 400;\n    margin: 0 0 4px 0;\n    font-family: 'Helvetica Neue', Arial, sans-serif;\n    line-height: 1.4;\n  }\n  .banner-3x2-{{ section.id }} p:last-child {\n    margin-bottom: 0;\n  }\n  .banner-3x2-{{ section.id }} p strong {\n    font-weight: 700;\n  }\n  @media (max-width: 600px) {\n    .banner-3x2-{{ section.id }} p {\n      font-size: 14px;\n    }\n  }\n</style>"
          }
        },
        "custom_w7xaet": {
          "type": "custom",
          "settings": {
            "code": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\" />\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\" />\n  <title>Product Features</title>\n  <style>\n    :root {\n      --text-color: #333;\n      --hover-bg-color: #f1f1f1;\n      --highlight-color: #000;\n      --transition-duration: 0.3s;\n      --font-family: 'Helvetica Neue', Arial, sans-serif;\n    }\n\n    body.bdy-a123 {\n      font-family: var(--font-family);\n      display: flex;\n      justify-content: flex-start;\n      align-items: flex-start;\n      height: 100vh;\n      margin: 0;\n      background: none;\n      padding: 20px;\n    }\n\n    .container-x987 {\n      width: 100%;\n      max-width: 600px;\n      display: flex;\n      flex-direction: column;\n      gap: 5px;\n    }\n\n    .item-z456 {\n      display: flex;\n      align-items: center;\n      padding: 5px 0;\n      border-radius: 8px;\n      transition: background-color var(--transition-duration) ease, transform var(--transition-duration) ease;\n      cursor: default;\n    }\n\n    .item-z456:hover {\n      background-color: var(--hover-bg-color);\n      transform: translateX(10px);\n    }\n\n    .icon-w321 {\n      width: 24px;\n      height: 24px;\n      margin-right: 10px;\n      transition: filter var(--transition-duration) ease;\n    }\n\n    .item-z456:hover .icon-w321 {\n      filter: brightness(0) invert(0);\n    }\n\n    .text-v654 {\n      font-size: 16px;\n      color: var(--text-color);\n      transition: color var(--transition-duration) ease;\n    }\n\n    .item-z456:hover .text-v654 {\n      color: var(--highlight-color);\n    }\n\n    /* Color especial para la primera línea */\n    .first-feature {\n      color: #007E3E;\n    }\n\n    @media (max-width: 600px) {\n      .text-v654 {\n        font-size: 14px;\n      }\n    }\n  </style>\n</head>\n<body class=\"bdy-a123\">\n  <div class=\"container-x987\">\n    <!-- Línea 1 con color personalizado -->\n    <div class=\"item-z456\">\n      <img src=\"https://cdn.shopify.com/s/files/1/0717/3006/9807/files/93_7989693e-c3eb-4e28-904f-f4018e94fbfa.png?v=1750358581\" alt=\"Check Icon\" class=\"icon-w321\" />\n      <div class=\"text-v654 first-feature\">En stock - Recibe desde 60 min / 48 hrs región</div>\n    </div>\n\n    <!-- Línea 2 -->\n    <div class=\"item-z456\">\n      <img src=\"https://cdn.shopify.com/s/files/1/0717/3006/9807/files/92_200e5555-59f7-445f-ad73-827db58fe3b6.png?v=1750358580\" alt=\"Check Icon\" class=\"icon-w321\" />\n      <div class=\"text-v654\">Envío gratis en compras superiores a 80.000</div>\n    </div>\n\n    <!-- Línea 3 -->\n    <div class=\"item-z456\">\n      <img src=\"https://cdn.shopify.com/s/files/1/0717/3006/9807/files/92_200e5555-59f7-445f-ad73-827db58fe3b6.png?v=1750358580\" alt=\"Check Icon\" class=\"icon-w321\" />\n      <div class=\"text-v654\">Devoluciones y cambios fáciles</div>\n    </div>\n  </div>\n</body>\n</html>"
          }
        },
        "custom_rAfDz6": {
          "type": "custom",
          "settings": {
            "code": "{% assign su_handle = 'mas-vendidos' %}\n{% assign su_titulo = 'Arma tu conjunto y aprovecha el 3×2' %}\n{% assign su_boton = 'Agregar al carrito' %}\n{% assign su_max = 10 %}\n\n{% assign su_coleccion = collections[su_handle] %}\n{% if su_coleccion == blank %}{% assign su_coleccion = collections.all %}{% endif %}\n{% assign su_contador = 0 %}\n\n<div id=\"SetUpsellSV\" class=\"su-wrap\" data-boton=\"{{ su_boton | escape }}\" data-product-id=\"{{ product.id }}\" data-variante-actual=\"{{ product.selected_or_first_available_variant.id }}\" data-max=\"{{ su_max }}\" data-money=\"{{ shop.money_format | escape }}\">\n\n  <p class=\"su-titulo\">{{ su_titulo }}</p>\n\n  <div class=\"su-viewport\">\n\n    <button type=\"button\" class=\"su-nav su-nav--prev\" data-su-nav=\"prev\" aria-label=\"Ver anteriores\" hidden>\n      <svg viewBox=\"0 0 24 24\" width=\"18\" height=\"18\" fill=\"none\" aria-hidden=\"true\" focusable=\"false\"><path d=\"M15 5L8 12L15 19\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/></svg>\n    </button>\n\n    <div class=\"su-track\" data-su-track>\n\n      {% for su_item in su_coleccion.products %}\n      {% if su_contador < su_max %}\n      {% if su_item.id != product.id and su_item.available %}\n\n      {% assign su_var = su_item.first_available_variant %}\n      {% assign su_alt = su_item.featured_image.alt | default: su_item.title %}\n\n      <div class=\"su-card\" data-su-card data-variant-id=\"{{ su_var.id }}\" data-selected=\"false\" role=\"button\" tabindex=\"0\" aria-pressed=\"false\" aria-label=\"Agregar {{ su_item.title | escape }} a la selección\">\n\n        <span class=\"su-check\" aria-hidden=\"true\">\n          <svg viewBox=\"0 0 24 24\" width=\"14\" height=\"14\" fill=\"none\" focusable=\"false\"><path d=\"M4 12.5L9.5 18L20 6\" stroke=\"currentColor\" stroke-width=\"3\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/></svg>\n        </span>\n\n        <div class=\"su-media\">\n          {% if su_item.featured_image %}\n          <img src=\"{{ su_item.featured_image | image_url: width: 400 }}\" alt=\"{{ su_alt | escape }}\" width=\"400\" height=\"400\" loading=\"lazy\" class=\"su-img\">\n          {% endif %}\n        </div>\n\n        <p class=\"su-nombre\" title=\"{{ su_item.title | escape }}\">{{ su_item.title }}</p>\n\n        <div class=\"su-slot\">\n        {% if su_item.variants.size > 1 %}\n          <div class=\"su-selectwrap\">\n            <select class=\"su-select\" data-su-variant aria-label=\"Elegir opción de {{ su_item.title | escape }}\">\n              {% for su_opcion in su_item.variants %}<option value=\"{{ su_opcion.id }}\" data-precio=\"{{ su_opcion.price | money }}\" data-comparar=\"{% if su_opcion.compare_at_price > su_opcion.price %}{{ su_opcion.compare_at_price | money }}{% endif %}\"{% unless su_opcion.available %} disabled{% endunless %}{% if su_opcion.id == su_var.id %} selected{% endif %}>{{ su_opcion.title }}{% unless su_opcion.available %} — Agotado{% endunless %}</option>{% endfor %}\n            </select>\n            <svg class=\"su-caret\" viewBox=\"0 0 24 24\" width=\"14\" height=\"14\" fill=\"none\" aria-hidden=\"true\" focusable=\"false\"><path d=\"M6 9L12 15L18 9\" stroke=\"currentColor\" stroke-width=\"2.2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/></svg>\n          </div>\n        {% endif %}\n        </div>\n\n        <div class=\"su-precios\">\n          <span class=\"su-precio {% if su_var.compare_at_price > su_var.price %}su-precio--oferta{% else %}su-precio--normal{% endif %}\" data-su-precio>{{ su_var.price | money }}</span>\n          <span class=\"su-precio su-precio--antes\" data-su-antes{% unless su_var.compare_at_price > su_var.price %} hidden{% endunless %}>{% if su_var.compare_at_price > su_var.price %}{{ su_var.compare_at_price | money }}{% endif %}</span>\n        </div>\n\n      </div>\n\n      {% assign su_contador = su_contador | plus: 1 %}\n\n      {% endif %}\n      {% endif %}\n      {% endfor %}\n\n    </div>\n\n    <button type=\"button\" class=\"su-nav su-nav--next\" data-su-nav=\"next\" aria-label=\"Ver siguientes\" hidden>\n      <svg viewBox=\"0 0 24 24\" width=\"18\" height=\"18\" fill=\"none\" aria-hidden=\"true\" focusable=\"false\"><path d=\"M9 5L16 12L9 19\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/></svg>\n    </button>\n\n  </div>\n\n  <button type=\"button\" class=\"su-cta\" data-su-submit disabled>\n    <span data-su-label>{{ su_boton }}</span>\n  </button>\n\n  <p class=\"su-feedback\" data-su-feedback role=\"status\" aria-live=\"polite\"></p>\n\n</div>\n\n<style>\n#SetUpsellSV{--su-tinta:#141414;--su-oferta:#C8102E;--su-gris:#9A9A9A;--su-linea:#E4E4E4;--su-fondo:#F6F6F6;display:block;margin:24px 0;font-family:inherit;text-align:left;box-sizing:border-box}\n#SetUpsellSV *{box-sizing:border-box;font-family:inherit}\n#SetUpsellSV .su-titulo{margin:0 0 14px;font-size:17px;font-weight:700;line-height:1.3;letter-spacing:0;color:var(--su-tinta);text-transform:none;text-align:left}\n#SetUpsellSV .su-viewport{position:relative}\n#SetUpsellSV .su-track{display:flex;align-items:stretch;gap:10px;padding:4px 2px;overflow-x:auto;scroll-snap-type:x mandatory;scroll-behavior:smooth;scrollbar-width:none;-ms-overflow-style:none}\n#SetUpsellSV .su-track::-webkit-scrollbar{display:none}\n#SetUpsellSV .su-card{position:relative;display:flex;flex-direction:column;flex:0 0 auto;width:158px;padding:10px;background:#FFF;border:1px solid var(--su-linea);border-radius:6px;scroll-snap-align:start;cursor:pointer;user-select:none;transition:border-color .18s ease,box-shadow .18s ease}\n#SetUpsellSV .su-card.is-selected{border-color:var(--su-tinta);box-shadow:0 0 0 1px var(--su-tinta)}\n#SetUpsellSV .su-card:focus-visible{outline:2px solid var(--su-tinta);outline-offset:2px}\n#SetUpsellSV .su-check{position:absolute;top:16px;right:16px;z-index:2;display:flex;align-items:center;justify-content:center;width:22px;height:22px;background:#FFF;border:1.5px solid #C9C9C9;border-radius:4px;color:transparent;transition:all .15s ease}\n#SetUpsellSV .su-card.is-selected .su-check{background:var(--su-tinta);border-color:var(--su-tinta);color:#FFF}\n#SetUpsellSV .su-media{flex:0 0 auto;margin-bottom:10px;aspect-ratio:1/1;background:var(--su-fondo);border-radius:4px;overflow:hidden}\n#SetUpsellSV .su-img{display:block;width:100%;height:100%;object-fit:contain}\n#SetUpsellSV .su-nombre{display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden;flex:0 0 auto;margin:0 0 8px;height:32px;font-size:12px;font-weight:700;line-height:16px;color:var(--su-tinta);text-transform:none;letter-spacing:0;text-align:left}\n#SetUpsellSV .su-slot{flex:1 0 auto;min-height:42px;margin-bottom:2px}\n#SetUpsellSV .su-selectwrap{position:relative}\n#SetUpsellSV .su-select{-webkit-appearance:none;-moz-appearance:none;appearance:none;width:100%;height:34px;margin:0;padding:0 26px 0 10px;font-size:12px;font-weight:700;letter-spacing:.02em;line-height:34px;color:var(--su-tinta);background:#FFF;border:1px solid #D6D6D6;border-radius:4px;cursor:pointer;box-shadow:0 1px 0 rgba(0,0,0,.04);transition:border-color .15s ease}\n#SetUpsellSV .su-select:hover{border-color:var(--su-tinta)}\n#SetUpsellSV .su-select:focus{outline:none;border-color:var(--su-tinta)}\n#SetUpsellSV .su-select option:disabled{color:#B4B4B4}\n#SetUpsellSV .su-caret{position:absolute;top:17px;right:8px;transform:translateY(-50%);pointer-events:none;color:var(--su-tinta)}\n#SetUpsellSV .su-precios{display:flex;flex-wrap:wrap;align-items:baseline;gap:6px;flex:0 0 auto}\n#SetUpsellSV .su-precio{font-size:13px}\n#SetUpsellSV .su-precio--oferta{font-weight:700;color:var(--su-oferta)}\n#SetUpsellSV .su-precio--normal{font-weight:700;color:var(--su-tinta)}\n#SetUpsellSV .su-precio--antes{font-weight:400;color:var(--su-gris);text-decoration:line-through}\n#SetUpsellSV .su-precio--antes[hidden]{display:none}\n#SetUpsellSV .su-nav{position:absolute;top:42%;z-index:3;display:flex;align-items:center;justify-content:center;width:34px;height:34px;padding:0;min-width:0;background:var(--su-tinta);border:0;border-radius:50%;color:#FFF;cursor:pointer;transform:translateY(-50%)}\n#SetUpsellSV .su-nav--prev{left:-6px}\n#SetUpsellSV .su-nav--next{right:-6px}\n#SetUpsellSV .su-nav[hidden]{display:none}\n#SetUpsellSV .su-cta{display:flex;align-items:center;justify-content:center;width:100%;margin-top:18px;padding:18px 20px;font-family:inherit;font-size:14px;font-weight:400;letter-spacing:.18em;text-transform:uppercase;color:#FFF;background:#141414;border:0;border-radius:0;box-shadow:0 10px 24px rgba(0,0,0,.18);cursor:pointer;transition:opacity .18s ease}\n#SetUpsellSV .su-cta:hover{opacity:.88}\n#SetUpsellSV .su-cta:disabled{opacity:.45;cursor:not-allowed;box-shadow:0 6px 16px rgba(0,0,0,.10)}\n#SetUpsellSV .su-feedback{margin:8px 0 0;min-height:16px;font-size:12px;text-align:center;color:#6B6B6B}\n#SetUpsellSV.is-loading .su-track{opacity:.45;transition:opacity .2s ease}\n@media screen and (min-width:750px){#SetUpsellSV .su-titulo{font-size:20px}#SetUpsellSV .su-card{width:186px}#SetUpsellSV .su-nombre{height:34px;font-size:13px;line-height:17px}#SetUpsellSV .su-nav--prev{left:-14px}#SetUpsellSV .su-nav--next{right:-14px}}\n</style>\n\n<script>\n(function(){\n  function initSetUpsell(){\n    var root = document.getElementById('SetUpsellSV');\n    if(!root || root.getAttribute('data-su-ready') === 'true') return;\n    root.setAttribute('data-su-ready','true');\n\n    var track = root.querySelector('[data-su-track]');\n    var submit = root.querySelector('[data-su-submit]');\n    var label = root.querySelector('[data-su-label]');\n    var feedback = root.querySelector('[data-su-feedback]');\n    var prev = root.querySelector('[data-su-nav=\"prev\"]');\n    var next = root.querySelector('[data-su-nav=\"next\"]');\n    var baseLabel = root.getAttribute('data-boton') || 'Agregar al carrito';\n    var productId = root.getAttribute('data-product-id');\n    var varianteBase = root.getAttribute('data-variante-actual');\n    var maxItems = parseInt(root.getAttribute('data-max'), 10) || 10;\n    var moneyFormat = root.getAttribute('data-money') || '${{amount}}';\n    var rootUrl = (window.Shopify && window.Shopify.routes && window.Shopify.routes.root) || '/';\n    var cards = [];\n    var cierreInstalado = false;\n\n    function esc(s){\n      return String(s == null ? '' : s).replace(/[&<>\"']/g, function(c){\n        return {'&':'&amp;','<':'&lt;','>':'&gt;','\"':'&quot;',\"'\":'&#39;'}[c];\n      });\n    }\n\n    function money(cents){\n      var value = (cents || 0) / 100;\n      function group(num, dec, mil, sep){\n        var fixed = num.toFixed(dec);\n        var parts = fixed.split('.');\n        parts[0] = parts[0].replace(/\\B(?=(\\d{3})+(?!\\d))/g, mil);\n        return parts.length > 1 ? parts.join(sep) : parts[0];\n      }\n      return moneyFormat.replace(/\\{\\{\\s*(\\w+)\\s*\\}\\}/g, function(_, t){\n        if(t === 'amount') return group(value,2,',','.');\n        if(t === 'amount_no_decimals') return group(value,0,',','');\n        if(t === 'amount_with_comma_separator') return group(value,2,'.',',');\n        if(t === 'amount_no_decimals_with_comma_separator') return group(value,0,'.','');\n        if(t === 'amount_with_apostrophe_separator') return group(value,2,\"'\",'.');\n        if(t === 'amount_no_decimals_with_space_separator') return group(value,0,' ','');\n        return group(value,2,',','.');\n      });\n    }\n\n    function imgUrl(url){\n      if(!url) return '';\n      var full = url.indexOf('//') === 0 ? 'https:' + url : url;\n      return full + (full.indexOf('?') > -1 ? '&' : '?') + 'width=400';\n    }\n\n    function varianteDelProducto(){\n      var selectores = [\n        'form[action*=\"/cart/add\"] select[name=\"id\"]',\n        'form[action*=\"/cart/add\"] input[name=\"id\"]',\n        '[data-product-select]',\n        'select[name=\"id\"]',\n        'input[name=\"id\"]'\n      ];\n      for(var i = 0; i < selectores.length; i++){\n        var el = document.querySelector(selectores[i]);\n        if(el && el.value && /^\\d+$/.test(String(el.value).trim())){\n          return parseInt(el.value, 10);\n        }\n      }\n      var desdeUrl = new URL(window.location.href).searchParams.get('variant');\n      if(desdeUrl && /^\\d+$/.test(desdeUrl)) return parseInt(desdeUrl, 10);\n      return parseInt(varianteBase, 10);\n    }\n\n    function cardHTML(p){\n      var todas = p.variants || [];\n      var disponibles = todas.filter(function(v){ return v.available; });\n      if(!disponibles.length) return '';\n      var v = disponibles[0];\n      var oferta = v.compare_at_price && v.compare_at_price > v.price;\n\n      var slot = '';\n      if(todas.length > 1){\n        var opts = todas.map(function(o){\n          var cmp = (o.compare_at_price && o.compare_at_price > o.price) ? money(o.compare_at_price) : '';\n          return '<option value=\"' + o.id + '\" data-precio=\"' + esc(money(o.price)) + '\" data-comparar=\"' + esc(cmp) + '\"'\n            + (o.available ? '' : ' disabled')\n            + (o.id === v.id ? ' selected' : '') + '>'\n            + esc(o.title) + (o.available ? '' : ' — Agotado') + '</option>';\n        }).join('');\n        slot = '<div class=\"su-selectwrap\"><select class=\"su-select\" data-su-variant aria-label=\"Elegir opción de ' + esc(p.title) + '\">' + opts + '</select>'\n          + '<svg class=\"su-caret\" viewBox=\"0 0 24 24\" width=\"14\" height=\"14\" fill=\"none\" aria-hidden=\"true\"><path d=\"M6 9L12 15L18 9\" stroke=\"currentColor\" stroke-width=\"2.2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/></svg></div>';\n      }\n\n      return '<div class=\"su-card\" data-su-card data-variant-id=\"' + v.id + '\" data-selected=\"false\" role=\"button\" tabindex=\"0\" aria-pressed=\"false\" aria-label=\"Agregar ' + esc(p.title) + ' a la selección\">'\n        + '<span class=\"su-check\" aria-hidden=\"true\"><svg viewBox=\"0 0 24 24\" width=\"14\" height=\"14\" fill=\"none\"><path d=\"M4 12.5L9.5 18L20 6\" stroke=\"currentColor\" stroke-width=\"3\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/></svg></span>'\n        + '<div class=\"su-media\">' + (p.featured_image ? '<img class=\"su-img\" src=\"' + esc(imgUrl(p.featured_image)) + '\" alt=\"' + esc(p.title) + '\" width=\"400\" height=\"400\" loading=\"lazy\">' : '') + '</div>'\n        + '<p class=\"su-nombre\" title=\"' + esc(p.title) + '\">' + esc(p.title) + '</p>'\n        + '<div class=\"su-slot\">' + slot + '</div>'\n        + '<div class=\"su-precios\">'\n        + '<span class=\"su-precio ' + (oferta ? 'su-precio--oferta' : 'su-precio--normal') + '\" data-su-precio>' + esc(money(v.price)) + '</span>'\n        + '<span class=\"su-precio su-precio--antes\" data-su-antes' + (oferta ? '' : ' hidden') + '>' + (oferta ? esc(money(v.compare_at_price)) : '') + '</span>'\n        + '</div></div>';\n    }\n\n    function seleccionadas(){\n      return cards.filter(function(c){ return c.getAttribute('data-selected') === 'true'; });\n    }\n\n    function refresh(){\n      var n = seleccionadas().length;\n      if(submit) submit.disabled = n === 0;\n      if(label) label.textContent = baseLabel;\n    }\n\n    function toggle(card){\n      var on = card.getAttribute('data-selected') !== 'true';\n      card.setAttribute('data-selected', on ? 'true' : 'false');\n      card.setAttribute('aria-pressed', on ? 'true' : 'false');\n      card.classList.toggle('is-selected', on);\n      refresh();\n    }\n\n    function bindCards(){\n      cards = Array.prototype.slice.call(root.querySelectorAll('[data-su-card]'));\n      cards.forEach(function(card){\n        card.addEventListener('click', function(e){\n          if(e.target.closest && e.target.closest('.su-selectwrap')) return;\n          toggle(card);\n        });\n        card.addEventListener('keydown', function(e){\n          if(e.key !== 'Enter' && e.key !== ' ') return;\n          e.preventDefault();\n          toggle(card);\n        });\n\n        var select = card.querySelector('[data-su-variant]');\n        if(!select) return;\n        select.addEventListener('click', function(e){ e.stopPropagation(); });\n        select.addEventListener('change', function(e){\n          e.stopPropagation();\n          var opt = select.options[select.selectedIndex];\n          if(opt.disabled) return;\n          var precioEl = card.querySelector('[data-su-precio]');\n          var antesEl = card.querySelector('[data-su-antes]');\n          var antes = opt.getAttribute('data-comparar') || '';\n          card.setAttribute('data-variant-id', opt.value);\n          precioEl.textContent = opt.getAttribute('data-precio') || '';\n          if(antes){\n            precioEl.className = 'su-precio su-precio--oferta';\n            antesEl.textContent = antes;\n            antesEl.hidden = false;\n          } else {\n            precioEl.className = 'su-precio su-precio--normal';\n            antesEl.textContent = '';\n            antesEl.hidden = true;\n          }\n        });\n      });\n      refresh();\n      flechas();\n    }\n\n    function pedir(intent){\n      var url = rootUrl + 'recommendations/products.json?product_id=' + productId + '&limit=' + maxItems + '&intent=' + intent;\n      return fetch(url, {headers:{'Accept':'application/json'}})\n        .then(function(r){ return r.ok ? r.json() : {products:[]}; })\n        .then(function(d){ return (d && d.products) ? d.products : []; })\n        .catch(function(){ return []; });\n    }\n\n    function cargarRecomendaciones(){\n      root.classList.add('is-loading');\n      pedir('complementary').then(function(list){\n        if(list.length >= 3) return list;\n        return pedir('related');\n      }).then(function(list){\n        root.classList.remove('is-loading');\n        var validos = list.filter(function(p){\n          return p.available && String(p.id) !== String(productId);\n        }).slice(0, maxItems);\n\n        if(validos.length >= 3){\n          var html = validos.map(cardHTML).join('');\n          if(html){ track.innerHTML = html; }\n        }\n        bindCards();\n      }).catch(function(){\n        root.classList.remove('is-loading');\n        bindCards();\n      });\n    }\n\n    function flechas(){\n      if(!track) return;\n      var over = track.scrollWidth - track.clientWidth > 4;\n      if(prev) prev.hidden = !over || track.scrollLeft <= 4;\n      if(next) next.hidden = !over || track.scrollLeft >= track.scrollWidth - track.clientWidth - 4;\n    }\n\n    if(track){\n      if(prev) prev.addEventListener('click', function(){ track.scrollBy({left: -track.clientWidth * 0.7, behavior:'smooth'}); });\n      if(next) next.addEventListener('click', function(){ track.scrollBy({left: track.clientWidth * 0.7, behavior:'smooth'}); });\n      track.addEventListener('scroll', flechas, {passive:true});\n      window.addEventListener('resize', flechas);\n    }\n\n    function cerrarCarrito(){\n      var drawer = document.getElementById('CartDrawer');\n      document.documentElement.classList.remove('js-drawer-open','js-drawer-open-right');\n      document.body.classList.remove('js-drawer-open','js-drawer-open-right');\n      if(drawer){\n        drawer.classList.remove('drawer--is-open');\n        drawer.setAttribute('aria-hidden','true');\n      }\n    }\n\n    // Solo se instala si tuvimos que abrir el cajón manualmente\n    function instalarCierreDeEmergencia(){\n      if(cierreInstalado) return;\n      cierreInstalado = true;\n\n      // Botón X del cajón y cualquier elemento de cierre del tema\n      document.addEventListener('click', function(e){\n        if(!document.documentElement.classList.contains('js-drawer-open')) return;\n        var t = e.target;\n        if(t.closest && t.closest('.js-drawer-close, .drawer__close-button, .drawer__close')){\n          cerrarCarrito();\n        }\n      }, true);\n\n      // Clic fuera del cajón\n      document.addEventListener('click', function(e){\n        if(!document.documentElement.classList.contains('js-drawer-open')) return;\n        var drawer = document.getElementById('CartDrawer');\n        if(!drawer) return;\n        if(drawer.contains(e.target)) return;\n        if(e.target.closest && e.target.closest('#SetUpsellSV')) return;\n        if(e.target.closest && e.target.closest('.site-header__cart, .js-drawer-open-cart')) return;\n        cerrarCarrito();\n      });\n\n      // Tecla Escape\n      document.addEventListener('keydown', function(e){\n        if(e.key === 'Escape' || e.key === 'Esc'){ cerrarCarrito(); }\n      });\n    }\n\n    function abrirCarrito(){\n      var drawer = document.getElementById('CartDrawer');\n\n      try{\n        if(window.theme && theme.cart){\n          if(typeof theme.cart.getCart === 'function') theme.cart.getCart();\n          else if(typeof theme.cart.buildCart === 'function') theme.cart.buildCart();\n        }\n      }catch(e){}\n\n      ['cart:build','cart:refresh','cart:updated','cart:open']\n        .forEach(function(n){ document.dispatchEvent(new CustomEvent(n, {bubbles:true, detail:{}})); });\n\n      // Vía preferente: el propio ícono del tema (abre y cierra con su lógica normal)\n      var toggle = document.querySelector(\n        '.js-drawer-open-cart, [data-drawer-toggle=\"CartDrawer\"], .site-header__cart-toggle, .site-header__cart, #CartToggle, .header__icon--cart, a[href$=\"/cart\"]'\n      );\n      if(toggle){\n        try{ toggle.click(); }catch(e){}\n      }\n\n      // Respaldo solo si el tema no lo abrió\n      setTimeout(function(){\n        var abierto = drawer && drawer.className.indexOf('drawer--is-open') !== -1;\n        if(abierto) return;\n\n        instalarCierreDeEmergencia();\n        document.documentElement.classList.add('js-drawer-open','js-drawer-open-right');\n        document.body.classList.add('js-drawer-open','js-drawer-open-right');\n        if(drawer){\n          drawer.classList.add('drawer--is-open');\n          drawer.setAttribute('aria-hidden','false');\n        }\n      }, 350);\n    }\n\n    if(submit){\n      submit.addEventListener('click', function(e){\n        e.preventDefault();\n        e.stopPropagation();\n\n        var sel = seleccionadas();\n        if(!sel.length) return;\n        submit.disabled = true;\n        if(feedback) feedback.textContent = 'Agregando...';\n\n        var items = [];\n        var actual = varianteDelProducto();\n        if(actual){ items.push({ id: actual, quantity: 1 }); }\n\n        sel.forEach(function(c){\n          var id = parseInt(c.getAttribute('data-variant-id'), 10);\n          if(id && id !== actual){ items.push({ id: id, quantity: 1 }); }\n        });\n\n        fetch(rootUrl + 'cart/add.js', {\n          method: 'POST',\n          headers: {'Content-Type':'application/json','Accept':'application/json'},\n          body: JSON.stringify({items: items})\n        })\n        .then(function(r){ return r.json().then(function(d){ return {ok: r.ok, data: d}; }); })\n        .then(function(res){\n          if(!res.ok) throw new Error((res.data && res.data.description) || 'No se pudo agregar al carrito.');\n          if(feedback) feedback.textContent = '';\n          sel.forEach(function(c){\n            c.setAttribute('data-selected','false');\n            c.setAttribute('aria-pressed','false');\n            c.classList.remove('is-selected');\n          });\n          refresh();\n          setTimeout(abrirCarrito, 150);\n        })\n        .catch(function(err){\n          if(feedback) feedback.textContent = err.message;\n          submit.disabled = false;\n        });\n      });\n    }\n\n    bindCards();\n    if(productId){ cargarRecomendaciones(); }\n  }\n\n  if(document.readyState === 'loading'){\n    document.addEventListener('DOMContentLoaded', initSetUpsell);\n  } else {\n    initSetUpsell();\n  }\n  document.addEventListener('shopify:section:load', initSetUpsell);\n})();\n</script>"
          }
        },
