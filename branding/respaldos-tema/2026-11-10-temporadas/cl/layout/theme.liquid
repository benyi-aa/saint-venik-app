<style>
  #svcd-1 {
    background: #000000;
    color: #FFFFFF;
    width: 100%;
    padding: 12px 16px;
    box-sizing: border-box;
    font-family: inherit;
    min-height: 96px;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  #svcd-1 *,
  #svcd-1 *::before,
  #svcd-1 *::after { box-sizing: border-box; }
  #svcd-1 .svcd__inner {
    width: 100%;
    max-width: 1400px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 10px;
  }
  /* El banner entero es pulsable: titulo y reloj son enlaces, pero se tienen
     que ver igual que antes. */
  #svcd-1 .svcd__enlace {
    color: inherit;
    text-decoration: none;
    cursor: pointer;
  }
  #svcd-1 .svcd__titulo {
    margin: 0;
    font-size: 14px;
    font-weight: 700;
    letter-spacing: 0.03em;
    text-transform: uppercase;
    text-align: center;
    line-height: 1.25;
    color: #FFFFFF;
  }
  #svcd-1 .svcd__fila {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 16px;
    flex-wrap: wrap;
  }
  #svcd-1 .svcd__reloj {
    display: flex;
    align-items: flex-start;
    gap: 4px;
    visibility: hidden;
  }
  #svcd-1.svcd--listo .svcd__reloj { visibility: visible; }
  #svcd-1 .svcd__unidad {
    display: flex;
    flex-direction: column;
    align-items: center;
    min-width: 34px;
  }
  #svcd-1 .svcd__num {
    font-size: 20px;
    font-weight: 700;
    line-height: 1.1;
    font-variant-numeric: tabular-nums;
    color: #FFFFFF;
  }
  #svcd-1 .svcd__etiqueta {
    font-size: 11px;
    line-height: 1.4;
    opacity: 0.85;
    color: #FFFFFF;
  }
  #svcd-1 .svcd__sep {
    font-size: 18px;
    font-weight: 700;
    line-height: 1.25;
    padding-top: 1px;
    opacity: 0.7;
    color: #FFFFFF;
  }
  #svcd-1 .svcd__boton {
    display: inline-block;
    background: #C8102E;
    color: #FFFFFF;
    text-decoration: none;
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    padding: 11px 20px;
    border-radius: 3px;
    white-space: nowrap;
    cursor: pointer;
    transition: opacity 0.2s ease;
  }
  #svcd-1 .svcd__boton:hover,
  #svcd-1 .svcd__boton:focus-visible {
    opacity: 0.88;
    color: #FFFFFF;
  }
  #svcd-1 .svcd__boton:focus-visible {
    outline: 2px solid #FFFFFF;
    outline-offset: 2px;
  }
  @media screen and (min-width: 769px) {
    #svcd-1 {
      padding: 10px 24px;
      min-height: 64px;
    }
    #svcd-1 .svcd__inner {
      flex-direction: row;
      justify-content: center;
      gap: 28px;
    }
    #svcd-1 .svcd__titulo { font-size: 16px; }
    #svcd-1 .svcd__fila { gap: 24px; }
    #svcd-1 .svcd__reloj { gap: 6px; }
    #svcd-1 .svcd__unidad { min-width: 40px; }
    #svcd-1 .svcd__num { font-size: 22px; }
    #svcd-1 .svcd__etiqueta { font-size: 12px; }
    #svcd-1 .svcd__sep { font-size: 20px; }
  }
</style>

