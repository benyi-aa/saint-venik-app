<div class="svcd" id="svcd-1"
     data-hora-fin="23"
     data-minuto-fin="59"
     data-destino="#barra-oferta, #barra-cyber"
     style="background:#000000;color:#FFFFFF;">
  <div class="svcd__inner">
    <a class="svcd__titulo svcd__enlace" href="{{ url_banner }}">VIP BLACK FRIDAY: 3X2 + HASTA 60% OFF</a>
    <div class="svcd__fila">
      <a class="svcd__reloj svcd__enlace" href="{{ url_banner }}">
        <div class="svcd__unidad">
          <span class="svcd__num" data-svcd-dias>00</span>
          <span class="svcd__etiqueta">Días</span>
        </div>
        <span class="svcd__sep" aria-hidden="true">:</span>
        <div class="svcd__unidad">
          <span class="svcd__num" data-svcd-horas>00</span>
          <span class="svcd__etiqueta">Horas</span>
        </div>
        <span class="svcd__sep" aria-hidden="true">:</span>
        <div class="svcd__unidad">
          <span class="svcd__num" data-svcd-min>00</span>
          <span class="svcd__etiqueta">Min</span>
        </div>
        <span class="svcd__sep" aria-hidden="true">:</span>
        <div class="svcd__unidad">
          <span class="svcd__num" data-svcd-seg>00</span>
          <span class="svcd__etiqueta">Seg</span>
        </div>
      </a>
      <a class="svcd__boton" data-svcd-cta href="{{ url_banner }}">COMPRAR AHORA</a>
    </div>
  </div>
</div>

<script>
(function () {
  var raiz = document.getElementById('svcd-1');
  if (!raiz || raiz.dataset.svcdInit) return;
  raiz.dataset.svcdInit = '1';

  /* ============ 1. CUENTA REGRESIVA ============ */

  var horaFin = parseInt(raiz.dataset.horaFin, 10);
  var minutoFin = parseInt(raiz.dataset.minutoFin, 10);
  if (isNaN(horaFin)) horaFin = 23;
  if (isNaN(minutoFin)) minutoFin = 59;

  var elDias  = raiz.querySelector('[data-svcd-dias]');
  var elHoras = raiz.querySelector('[data-svcd-horas]');
  var elMin   = raiz.querySelector('[data-svcd-min]');
  var elSeg   = raiz.querySelector('[data-svcd-seg]');

  function objetivo() {
    var ahora = new Date();
    var meta = new Date(ahora.getFullYear(), ahora.getMonth(), ahora.getDate(), horaFin, minutoFin, 59, 999);
    if (meta.getTime() <= ahora.getTime()) {
      meta = new Date(ahora.getFullYear(), ahora.getMonth(), ahora.getDate() + 1, horaFin, minutoFin, 59, 999);
    }
    return meta;
  }

  function dd(n) { return n < 10 ? '0' + n : String(n); }

  var meta = objetivo();

  function pintar() {
    var restante = meta.getTime() - Date.now();
    if (restante <= 0) {
      meta = objetivo();
      restante = meta.getTime() - Date.now();
    }
    var t = Math.floor(restante / 1000);
    if (elDias)  elDias.textContent  = dd(Math.floor(t / 86400));
    if (elHoras) elHoras.textContent = dd(Math.floor((t % 86400) / 3600));
    if (elMin)   elMin.textContent   = dd(Math.floor((t % 3600) / 60));
    if (elSeg)   elSeg.textContent   = dd(t % 60);
  }

  pintar();
  raiz.classList.add('svcd--listo');
  setInterval(pintar, 1000);

  document.addEventListener('visibilitychange', function () {
    if (!document.hidden) { meta = objetivo(); pintar(); }
  });

  /* ============ 2. EL BOTÓN, SOLO ESTANDO YA EN LA COLECCIÓN ============
   *
   * Desde CUALQUIER otra página el enlace navega y punto: la persona llega arriba de la
   * colección y decide ella si baja. Nada se mueve solo al cargar — un scroll automático
   * en una página recién abierta se siente como un fallo, no como una ayuda.
   *
   * El desplazamiento ocurre EXCLUSIVAMENTE cuando ya se está en /collections/best-sellers
   * y se pulsa el botón: ahí el enlace no tendría nada que hacer (recargaría la misma
   * página) y en su lugar lleva el ojo a la barra de la promo.
   */

  var cta = raiz.querySelector('[data-svcd-cta]');

  // ¿El enlace apunta a la página en la que ya estamos? Se comparan SOLO las rutas: los
  // filtros de colección viajan en la query y no cambian de página, y un prefijo de idioma
  // (/en/collections/...) sigue siendo la misma colección.
  function mismaPagina() {
    if (!cta) return false;
    var destino;
    try { destino = new URL(cta.getAttribute('href'), window.location.origin); }
    catch (e) { return false; }
    var a = destino.pathname.replace(/\/+$/, '');
    var b = window.location.pathname.replace(/\/+$/, '');
    return !!a && (b === a || b.slice(-a.length) === a);
  }

  // Alto de lo que quede PEGADO arriba (cabecera sticky, barra fija). Se mide por el estilo
  // calculado y no por la posición actual: antes de bajar, un sticky todavía está en su sitio
  // normal y medirlo ahí daría cero.
  function offsetFijo() {
    var alto = 0;
    var nodos = document.querySelectorAll(
      'header, .header, .header-wrapper, sticky-header, #shopify-section-header, ' +
      '[class*="sticky"], [class*="fixed"], [class*="announcement"]'
    );
    for (var i = 0; i < nodos.length; i++) {
      var n = nodos[i];
      if (n === raiz || n.contains(raiz) || raiz.contains(n)) continue;
      var cs = window.getComputedStyle(n);
      if (cs.position !== 'fixed' && cs.position !== 'sticky') continue;
      var top = parseFloat(cs.top);
      if (isNaN(top) || top > 8) continue;
      var h = n.getBoundingClientRect().height;
      if (h > alto && h < window.innerHeight * 0.5) alto = h;
    }
    return Math.round(alto);
  }

  // Dónde tiene que quedar el ojo: la barra de la promo, con la grilla justo debajo.
  // Tres intentos, del más fiable al más genérico.
  function buscarDestino() {
    // 1) Los ids fijados en data-destino. Van varios separados por coma a propósito: así
    //    este mismo bloque sirve al tema de Primavera y al de Cyber sin tocar una línea.
    //    querySelector devuelve el primero que exista en la página.
    var sel = (raiz.getAttribute('data-destino') || '').trim();
    if (sel) {
      try { var m = document.querySelector(sel); if (m) return m; } catch (e) {}
    }
    // 2) Red de seguridad si ese id desaparece: la barra reconocida por su propio texto.
    //    Se descarta cualquier contenedor grande — el envoltorio de toda la página también
    //    contiene esa frase.
    var secciones = document.querySelectorAll('.shopify-section, section, [id^="shopify-section-"]');
    for (var i = 0; i < secciones.length; i++) {
      var s = secciones[i];
      if (s === raiz || s.contains(raiz) || raiz.contains(s)) continue;
      var t = (s.textContent || '').replace(/\s+/g, ' ').trim();
      if (t.length > 0 && t.length < 400 && /a[ñn]ade\s*3\s*joyas/i.test(t)) return s;
    }
    // 3) Último recurso: la grilla de productos.
    var grilla = document.querySelector(
      '#ProductGridContainer, #main-collection-product-grid, #ProductGrid, ' +
      '.collection .product-grid, .product-grid, .collection'
    );
    if (grilla) return grilla.closest('.shopify-section') || grilla;
    return null;
  }

  function irAOfertas() {
    var d = buscarDestino();
    if (!d) return false;
    var suave = !(window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches);
    var y = window.pageYOffset + d.getBoundingClientRect().top - offsetFijo();
    if (y < 0) y = 0;
    try { window.scrollTo({ top: y, behavior: suave ? 'smooth' : 'auto' }); }
    catch (e) { window.scrollTo(0, y); }
    // Corrección: en una colección las imágenes cargan tarde y todo se corre unos píxeles.
    // Al terminar el desplazamiento se vuelve a medir y se ajusta lo que falte.
    setTimeout(function () {
      var falta = d.getBoundingClientRect().top - offsetFijo();
      if (Math.abs(falta) > 4) window.scrollBy(0, falta);
    }, suave ? 700 : 0);
    return true;
  }

  if (cta) {
    cta.addEventListener('click', function (ev) {
      // Se respeta abrir en pestaña nueva, el botón central y los modificadores.
      if (ev.defaultPrevented || ev.button !== 0 || ev.metaKey || ev.ctrlKey || ev.shiftKey || ev.altKey) return;
      if (!mismaPagina()) return;            // otra página: navegación normal, sin tocar nada
      if (irAOfertas()) ev.preventDefault(); // misma página: se baja, no se recarga
    });
  }
})();
</script>


